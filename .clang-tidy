---
Checks:
  - "-*"
  - bugprone-suspicious-stringview-data-usage
  - modernize-use-default-member-init
  - modernize-use-nullptr
  - modernize-use-override
  - readability-avoid-const-params-in-decls
  - readability-braces-around-statements
  - readability-const-return-type
  - readability-non-const-parameter
  - readability-redundant-inline-specifier
CheckOptions:
  bugprone-suspicious-stringview-data-usage.StringViewTypes: >-
    ::AZStd::basic_string_view;
    ::std::basic_string_view
  modernize-use-default-member-init.UseAssignment: true
  modernize-use-override.AllowOverrideAndFinal: true
ExcludeHeaderFilterRegex: "(^|[/\\])(3rdParty|External)([/\\]|$)"
FormatStyle: file
HeaderFileExtensions: ["", h, hh, hpp, hxx, inl]
HeaderFilterRegex: ".*"
ImplementationFileExtensions: [c, cc, cpp, cxx, m, mm]
SystemHeaders: false
...
