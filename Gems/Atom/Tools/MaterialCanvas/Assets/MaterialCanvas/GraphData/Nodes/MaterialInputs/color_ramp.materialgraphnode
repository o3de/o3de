        "category": "Material Inputs",
        "title": "Color Ramp Input",
        "titlePaletteName": "MaterialInputNodeTitlePalette",
        "description": "Maps a scalar input onto a four stop gradient. Every stop colour and position is exposed as a material property, so the gradient can be retuned on a finished material without regenerating shaders. Stop positions are expected in ascending order; the interpolation clamps rather than erroring if they are not.",
        "settings": {
            "instructions": [
                "SLOTTYPE(outColor) outColor = params.inColor1;",
                "outColor = lerp(outColor, params.inColor2, saturate(((float)inT - params.inPosition1) / max(params.inPosition2 - params.inPosition1, 0.0001)));",
                "outColor = lerp(outColor, params.inColor3, saturate(((float)inT - params.inPosition2) / max(params.inPosition3 - params.inPosition2, 0.0001)));",
                "outColor = lerp(outColor, params.inColor4, saturate(((float)inT - params.inPosition3) / max(params.inPosition4 - params.inPosition3, 0.0001)));"
            ]
        },
