#pragma once

// This #define magic allows you to use the EvaluateVertexGeometry function in this file without making it the final
// EvaluateVertexGeometry used in your shader. Simply #define EvaluateVertexGeometry before including this file
//
#ifndef EvaluateVertexGeometry
#define EvaluateVertexGeometry EvaluateVertexGeometry_MaterialGraphName
#endif

#include <Atom/RPI/TangentSpace.azsli>

VsOutput EvaluateVertexGeometry_MaterialGraphName(
    const MaterialParameters params,
    float3 position,
    real3 normal,
    real4 tangent,
    float2 uv0,
    float2 uv1,
    VsSystemValues SV,
    bool useVertexColor0,
    float4 color0)
{
    const float4x4 objectToWorld = GetObjectToWorldMatrix(SV);
    const float3x3 objectToWorldIT = GetObjectToWorldMatrixInverseTranspose(SV);
    const real4 positionWS = mul(objectToWorld, real4(position, 1.0));
    const real3 bitangent = cross(normal, (real3)tangent);

    real3 normalWS, tangentWS, bitangentWS;
    ConstructTBN(normal, tangent, objectToWorld, objectToWorldIT, normalWS, tangentWS, bitangentWS);

    const float3 O3DE_MC_POSITION = position;
    const float3 O3DE_MC_NORMAL = normal;
    const float3 O3DE_MC_TANGENT = tangent.xyz;
    const float3 O3DE_MC_BITANGENT = bitangent;
    const float3 O3DE_MC_POSITION_WS = positionWS.xyz;
    const float3 O3DE_MC_NORMAL_WS = normalWS;
    const float3 O3DE_MC_TANGENT_WS = tangentWS;
    const float3 O3DE_MC_BITANGENT_WS = bitangentWS;
    const float4 O3DE_MC_COLOR = color0;
    #define O3DE_MC_UV(index) (index == 0 ? uv0 : uv1);

    // placeholder to keep MaterialParams from being compiled out when iterating on graphs
    const int materialType = params.m_materialType;

    // Texture sampling nodes emit Texture2D::Sample, which needs screen-space derivatives to pick a mip and is only
    // legal in a pixel shader. Anything a graph routes into Position Offset is evaluated right here, in the vertex
    // stage, so a graph with a texture feeding Position Offset failed with
    //     error: Opcode Sample not valid in shader model vs_6_2
    // CS_SAMPLERS is the engine's existing flag for "this stage has no derivatives" -- GoboTexture, ParallaxMapping,
    // AlphaUtils, Ibl and Ltc all use it that way -- and sample_texture_2d already carries a SampleLevel branch
    // behind it. Defining it across the generated block selects that branch for vertex evaluation only. It sits
    // outside the BEGIN/END markers so the graph compiler, which rewrites only what is between them, preserves it.
    #define CS_SAMPLERS
    // O3DE_GENERATED_INSTRUCTIONS_BEGIN: inPositionOffset
    float3 inPositionOffset = {0.0, 0.0, 0.0};
    // O3DE_GENERATED_INSTRUCTIONS_END
    #undef CS_SAMPLERS

    #undef O3DE_MC_UV

    VsOutput output;
    output.worldPosition = (float3)positionWS + (float3)inPositionOffset;
    float4x4 viewProjectionMatrix = GetViewProjectionMatrix(SV);
    output.position = mul(viewProjectionMatrix, float4(output.worldPosition, 1.0));
    output.uvs[0] = uv0;
    output.uvs[1] = uv1;
    output.normal = normal;
    output.tangent = tangent;

#ifdef MATERIAL_USES_VERTEX_LOCALPOSITION
    // Object-space position, pre-multiplied by the entity's world scale.
    // - Object space  -> the projection rotates WITH the entity (consistent across rotated instances).
    // - World scale   -> texel density stays constant when the entity is scaled (no stretch).
    // Scale is recovered from the lengths of the object-to-world matrix columns
    // (transpose turns columns into rows so length() can read them).
    float3x3 o2wScale = transpose((float3x3)objectToWorld);
    float3 objectScale = float3(length(o2wScale[0]), length(o2wScale[1]), length(o2wScale[2]));
    output.localPosition = position * objectScale;
#endif
#if ENABLE_VERTEX_COLOR
    if(useVertexColor0)
    {
        output.color0 =  color0;
    }
    else
    {
        output.color0 = float4(1,1,1,1);
    }
#endif

    return output;
}

VsOutput EvaluateVertexGeometry_MaterialGraphName(VsInput IN, VsSystemValues SV, const MaterialParameters params)
{
#if ENABLE_VERTEX_COLOR
    float4 color0 = IN.m_optional_color0;
    bool useVertexColor = o_color0_isBound;
#else
    float4 color0 = float4(1.0f, 1.0f, 1.0f, 1.0f);
    bool useVertexColor = false;
#endif
    return EvaluateVertexGeometry_MaterialGraphName(
        params,
        IN.position,
        real3(IN.normal),
        real4(IN.tangent),
        IN.uv0,
        IN.uv1,
        SV,
        useVertexColor,
        color0);
}

VsOutput EvaluateVertexGeometry_MaterialGraphName(
    const MaterialParameters params,
    float3 position,
    real3 normal,
    real4 tangent,
    float2 uv0,
    float2 uv1,
    uint instanceId)
{
    VsSystemValues SV;
    SV.m_instanceId = instanceId;
    return EvaluateVertexGeometry_MaterialGraphName(
        params,
        position,
        normal,
        tangent,
        uv0,
        uv1,
        SV,
        false,
        float4(1.0f, 1.0f, 1.0f, 1.0f));
}
