{
    // Preview-only engine template copy with vulkan disabled to halve the job; remove "vulkan" if the editor runs on Vulkan.
    "DisabledRHIBackends": ["null", "vulkan"],

    // Compiled in process by the viewport; skipping include dependencies avoids a racing AP rebuild (see MaterialCanvasViewportContent).
    "SkipIncludeFileDependencies": true,
    // -O1: -O0 is slower here (240 ms vs 209 ms, larger DXIL); see "Investigated and rejected" in README.md.
    "AddBuildArguments": {
        "dxc": ["-O1"]
    },
    // Compile out area lights, decals, received shadows, debug views and light culling for the preview (~4,240 fewer lines for azslc).
    "Definitions": [
        "ENABLE_AREA_LIGHTS=0",
        "ENABLE_DECALS=0",
        "ENABLE_SHADOWS=0",
        "ENABLE_SHADER_DEBUGGING=0",
        "ENABLE_LIGHT_CULLING=0",

        // Drops the 808-line Aces.azsli from TransformColor; ACEScc conversions render magenta in the preview only.
        "ENABLE_ACESCC_COLOR_SPACE=0"
    ],

    "Source" : "",
    "DepthStencilState" :
    {
        "Depth" :
        {
            "Enable" : true,
            "CompareFunc" : "GreaterEqual",
            "writeMask": "Zero"
        },
        "Stencil" :
        {
            "Enable" : true,
            "ReadMask" : "0x00",
            "WriteMask" : "0xFF",
            "FrontFace" :
            {
                "Func" : "Always",
                "DepthFailOp" : "Keep",
                "FailOp" : "Keep",
                "PassOp" : "Replace"
            },
            "BackFace" :
            {
                "Func" : "Always",
                "DepthFailOp" : "Keep",
                "FailOp" : "Keep",
                "PassOp" : "Replace"
            }
        }
    },
    "GlobalTargetBlendState" :
    {
        "Enable" : true,
        "BlendSource" : "One",
        "BlendDest" : "ColorSource1",
        "BlendOp" : "Add"
    },
    "ProgramSettings":
    {
      "EntryPoints":
      [
        {
          "name": "VertexShader",
          "type": "Vertex"
        },
        {
          "name": "PixelShader",
          "type": "Fragment"
        }
      ]
    },
    "DrawList" : "transparent"
}
