#pragma once

#include "UnlitShared.azsli"

struct TransparentOutput
{
    float4 m_color : SV_Target0;
};

VertexShaderOutput MainVS(VertexShaderInput IN, uint instanceId : SV_InstanceID)
{
    return TransformVertex(IN, instanceId);
}

TransparentOutput MainPS(VertexShaderOutput IN)
{
    TransparentOutput OUT;

    const float4 baseColor = EvaluateBaseColor(IN);
    const float alpha = saturate(float(ResolveOpacityAlpha(IN, baseColor.a)) * UnlitColorSrg::m_opacityFactor);

    OUT.m_color = float4(baseColor.rgb * alpha, alpha);
    return OUT;
}
