// Batch build pass 3: add the per-block offset to each batch's block-local prefix sum (giving
// the final base offset), reset the per-batch write cursor, and emit one DrawIndirectCommand
// per batch (instanceCount = count; empty batches emit instanceCount 0 -> GPU no-ops them).

#include <scenesrg_all.srgi>
#include <Atom/Features/IndirectRendering.azsli>
#include <Atom/Features/GpuDriven/GpuDrivenConstants.azsli>

#define SCAN_BLOCK_SIZE 256

ShaderResourceGroup PassSrg : SRG_PerPass
{
    StructuredBuffer<uint> m_batchCount;           // in: per-batch counts (read-only)
    RWStructuredBuffer<uint> m_batchBaseOffset;    // in/out: block-local -> final base offset
    RWStructuredBuffer<uint> m_batchWriteCursor;   // out: reset to 0
    StructuredBuffer<uint> m_batchScanBlockSums;   // in: per-block offsets (read-only)
    RWStructuredBuffer<GpuDrivenIndirectCommand> m_indirectDrawArgs; // out: {batchId, draw args} per batch
};

[numthreads(SCAN_BLOCK_SIZE, 1, 1)]
void FinalizeCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint batchId = dispatchThreadID.x;
    if (batchId >= SceneSrg::m_gpuBatchCount)
    {
        return;
    }

    uint blockOffset = PassSrg::m_batchScanBlockSums[batchId / SCAN_BLOCK_SIZE];
    uint base = PassSrg::m_batchBaseOffset[batchId] + blockOffset;
    PassSrg::m_batchBaseOffset[batchId] = base;
    PassSrg::m_batchWriteCursor[batchId] = 0;

    uint count = PassSrg::m_batchCount[batchId];

    GpuDrivenIndirectCommand cmd;
    cmd.m_batchId = batchId;                                          // per-draw root constant
    cmd.m_drawArgs.m_vertexCountPerInstance = SceneSrg::m_batchInfo[batchId]; // indexCount (now uncapped)
    cmd.m_drawArgs.m_instanceCount = count;                           // 0 -> GPU no-ops the draw
    cmd.m_drawArgs.m_startVertexLocation = 0;                         // batchId no longer encoded here
    cmd.m_drawArgs.m_startInstanceLocation = 0;
    PassSrg::m_indirectDrawArgs[batchId] = cmd;
}
