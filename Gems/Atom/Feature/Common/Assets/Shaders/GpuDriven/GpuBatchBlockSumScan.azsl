// Batch build pass 2: single 256-wide group -- exclusive-scan the (<=256) per-block totals
// in place, turning them into per-block offsets that pass 3 adds back to each element.

#include <scenesrg_all.srgi>
#include <Atom/Features/GpuDriven/GpuBatchScanCommon.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWStructuredBuffer<uint> m_batchScanBlockSums; // in/out: block totals -> block offsets
};

[numthreads(SCAN_BLOCK_SIZE, 1, 1)]
void BlockSumScanCS(uint3 gtid : SV_GroupThreadID)
{
    uint tid = gtid.x;
    uint numBlocks = (SceneSrg::m_gpuBatchCount + SCAN_BLOCK_SIZE - 1) / SCAN_BLOCK_SIZE;
    s_scanData[tid] = (tid < numBlocks) ? PassSrg::m_batchScanBlockSums[tid] : 0u;
    GroupMemoryBarrierWithGroupSync();

    GpuBatch_ExclusiveScanLDS(tid);

    if (tid < numBlocks)
    {
        PassSrg::m_batchScanBlockSums[tid] = s_scanData[tid]; // now the block offset
    }
}
