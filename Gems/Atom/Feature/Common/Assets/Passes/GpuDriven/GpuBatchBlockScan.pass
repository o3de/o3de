            ],
            "Connections": [
                { "LocalSlot": "BatchBaseOffset",    "AttachmentRef": { "Pass": "This", "Attachment": "BatchBaseOffsetBuffer" } },
                { "LocalSlot": "BatchScanBlockSums", "AttachmentRef": { "Pass": "This", "Attachment": "BatchScanBlockSumsBuffer" } }
            ],
            "PassData": {
                "$type": "ComputePassData",
                "ShaderAsset": { "FilePath": "Shaders/GpuDriven/GpuBatchBlockScan.shader" },
                "BindViewSrg": true
            }
        }
    }
}
