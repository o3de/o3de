{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
      "PassTemplate": {
        "Name": "TransparentParentTemplate",
        "PassClass": "ParentPass",
        "Slots": [
          // Inputs...
          {
            "Name": "DirectionalShadowmap",
            "SlotType": "Input"
          },
          {
            "Name": "DirectionalESM",
            "SlotType": "Input"
          },
          {
            "Name": "ProjectedShadowmap",
            "SlotType": "Input"
          },
          {
            "Name": "ProjectedESM",
            "SlotType": "Input"
          },
          {
            "Name": "TileLightData",
            "SlotType": "Input"
          },
          {
            "Name": "LightListRemapped",
            "SlotType": "Input"
          },
          {
            "Name": "InputLinearDepth",
            "SlotType": "Input"
          },
          
          // Input/Outputs...
          {
            "Name": "DepthStencil",
            "SlotType": "InputOutput"
          },
          {
            "Name": "InputOutput",
            "SlotType": "InputOutput"
          }
        ],

        "ImageAttachments": [
          {
            "Name": "SceneColorCopy",
            "Lifetime": "Transient",
            "SizeSource": {
              "Source": {
                "Pass": "This",
                "Attachment": "InputOutput"
              }
            },
            "FormatSource": {
              "Pass": "This",
              "Attachment": "InputOutput"
            }
          }
        ],
        "PassRequests": [
          {
            "Name": "SceneColorCopyPass",
            "TemplateName": "FullscreenCopyTemplate",
            "Enabled": true,
            "Connections": [
              {
                "LocalSlot": "Input",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "InputOutput"
                }
              },
              {
                "LocalSlot": "Output",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "SceneColorCopy"
                }
              }
            ]
          },

          {
            "Name": "TransparentPass",
            "TemplateName": "TransparentPassTemplate",
            "Enabled": true,
            "Connections": [
              {
                "LocalSlot": "DirectionalLightShadowmap",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "DirectionalShadowmap"
                }
              },
              {
                "LocalSlot": "ExponentialShadowmapDirectional",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "DirectionalESM"
                }
              },
              {
                "LocalSlot": "ProjectedShadowmap",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "ProjectedShadowmap"
                }
              },
              {
                "LocalSlot": "ExponentialShadowmapProjected",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "ProjectedESM"
                }
              },
              {
                "LocalSlot": "TileLightData",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "TileLightData"
                }
              },
              {
                "LocalSlot": "LightListRemapped",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "LightListRemapped"
                }
              },
              {
                "LocalSlot": "InputLinearDepth",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "InputLinearDepth"
                }
              },
              {
                "LocalSlot": "SceneColorInput",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "SceneColorCopy"
                }
              },
              // Input/Outputs...
              {
                "LocalSlot": "DepthStencil",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "DepthStencil"
                }
              },
              {
                "LocalSlot": "InputOutput",
                "AttachmentRef": {
                  "Pass": "Parent",
                  "Attachment": "InputOutput"
                }
              }
            ],
            "PassData": {
              "$type": "RasterPassData",
              "DrawListTag": "transparent",
              "DrawListSortType": "KeyThenReverseDepth",
              "BindViewSrg": true,
              "PassSrgShaderAsset": {
                "FilePath": "Shaders/ForwardPassSrg.shader"
              }
            }
          }
        ]
      }
    }
}
