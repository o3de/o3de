#pragma once

#include <Atom/Features/SrgSemantics.azsli>

// For shaders drawn by a pass using this layout. Do not include alongside
// ForwardPassSrg.azsli in the same compiled shader.
ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_sceneColor;

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}
