#pragma once

#include <viewsrg_all.srgi>

bool HasSceneColorView()
{
    return ViewSrg::m_sceneColorViewAvailable != 0;
}

float2 GetSceneColorViewTexelSize()
{
    return HasSceneColorView() ? ViewSrg::m_sceneColorViewTexelSize : float2(0.0, 0.0);
}

float4 SampleSceneColorView(float2 screenUv)
{
    if (!HasSceneColorView())
    {
        return float4(0.0, 0.0, 0.0, 0.0);
    }
    return ViewSrg::m_sceneColorViewImage.SampleLevel(ViewSrg::m_sceneColorViewSampler, screenUv, 0.0);
}

float2 GetSceneColorViewScreenUV(float3 positionWS)
{
    float4 clipPosition = mul(ViewSrg::m_viewProjectionMatrix, float4(positionWS, 1.0));
    float divisor = abs(clipPosition.w) > 1e-6 ? clipPosition.w : (clipPosition.w < 0.0 ? -1e-6 : 1e-6);
    float2 ndc = clipPosition.xy / divisor;
    return float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
}

float4 SampleSceneColorViewFromWorld(float3 positionWS, float2 uvOffset)
{
    return SampleSceneColorView(GetSceneColorViewScreenUV(positionWS) + uvOffset);
}
