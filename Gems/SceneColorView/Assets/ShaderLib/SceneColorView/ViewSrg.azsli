#pragma once

// Include this through the PROJECT'S ShaderLib/viewsrg.srgi, so both
// SceneAndViewSrgs.shader and every material shader use the same layout.
// Do not declare a second SRG_PerView or SRG_PerPass group here.
partial ShaderResourceGroup ViewSrg
{
    Texture2D<float4> m_sceneColorViewImage;
    uint m_sceneColorViewAvailable;
    float2 m_sceneColorViewTexelSize;

    Sampler m_sceneColorViewSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}
