#include "ViewModeCommon.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    RWTexture2D<uint> m_mask;
}

[earlydepthstencil]
void MainPS(VsOutput IN, uint primitiveId : SV_PrimitiveID)
{
    const uint triangleId = primitiveId + ViewModeObjectSrg::m_idSeed;
    const uint scrambled = triangleId * 2654435761u;
    InterlockedOr(PassSrg::m_mask[uint2(IN.m_position.xy)], 1u << ((scrambled >> 27) & 31u));
}
