#include <Atom/Features/SrgSemantics.azsli>
#include "DiffuseProbeGridSampling.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    StructuredBuffer<DDGIProbeGrid> m_gridData;
    RWTexture2D<float4> m_probeRayTrace;
    RWTexture2D<float4> m_probeData;
    uint m_frameUpdateCount;
    uint m_frameUpdateIndex;
};

// Resolve the side of an ambiguous contact before the regular relocation iterations begin.
[numthreads(32, 1, 1)]
void MainCS(uint3 id : SV_DispatchThreadID)
{
    DDGIProbeGrid grid = PassSrg::m_gridData[0];
    uint3 counts = DDGIProbeCounts(grid);
    uint index = id.x * PassSrg::m_frameUpdateCount + PassSrg::m_frameUpdateIndex;
    if (index >= counts.x * counts.y * counts.z)
    {
        return;
    }

    uint3 coords = DDGIPhysicalCoords(DDGIProbeCoords(index, counts), grid);
    uint row = DDGIProbeIndex(coords, counts);
    uint rayCount = grid.packed2 & 65535;
    float minSpacing = min(grid.spacing.x, min(grid.spacing.y, grid.spacing.z));
    float3 coordinateBound = abs(grid.origin) + dot(grid.spacing, float3(counts)) * 0.5f;
    float scale = max(1.0f, max(coordinateBound.x, max(coordinateBound.y, coordinateBound.z)));
    // Bound the contact band in both world-space ULPs and probe-cell units.
    float tolerance = min(minSpacing * 0.0001f, scale * 8.0f * 1.192092896e-7f);
    float3 outward = 0.0f;
    uint contactHits = 0;
    for (uint ray = 0; ray < DDGIFixedRayCount; ++ray)
    {
        float distance = PassSrg::m_probeRayTrace[uint2(ray, row)].w;
        // A backface hit can round to -0.0, which compares equal to +0.0.
        bool back = (asuint(distance) & 0x80000000u) != 0;
        // DDGI stores backface distances at one fifth of world distance.
        if (abs(distance) <= (back ? 0.2f : 1.0f) * tolerance)
        {
            float3 direction = DDGIProbeDirection(ray, rayCount, grid.rayRotation);
            // A front hit points into the surface. A back hit points out.
            outward += back ? direction : -direction;
            ++contactHits;
        }
    }
    // Uniform hemisphere samples average half a unit along the normal. Require at least half
    // that alignment to avoid moving between opposing faces or acting on an empty ray row.
    float minOutwardLength = 0.25f * contactHits;
    if (contactHits >= 3 && dot(outward, outward) > minOutwardLength * minOutwardLength)
    {
        uint2 tile = DDGIProbeTile(coords, counts);
        float4 data = PassSrg::m_probeData[tile];
        float3 offset = data.xyz + normalize(outward) * (8.0f * tolerance) / grid.spacing;
        if (dot(offset, offset) < 0.45f * 0.45f)
        {
            PassSrg::m_probeData[tile] = float4(offset, data.w);
        }
    }
}
