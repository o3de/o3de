#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Buffer<float4> m_indirect;
    StructuredBuffer<float4> m_hitAlbedo;
    RWTexture2D<float4> m_output;
    uint m_rayCount;
};

[numthreads(64, 1, 1)]
void MainCS(uint3 id : SV_DispatchThreadID)
{
    uint count;
    PassSrg::m_indirect.GetDimensions(count);
    if (id.x >= count)
    {
        return;
    }
    float4 surface = PassSrg::m_hitAlbedo[id.x];
    if (surface.w <= 0.0f)
    {
        return;
    }
    uint2 ray = uint2(id.x % PassSrg::m_rayCount, uint(surface.w) - 1);
    float4 radianceAndDistance = PassSrg::m_output[ray];
    // The query RGB already includes the volume weight. Match the hardware bounce's reflectance cap and 1/(2*pi) scale.
    float3 irradiance = PassSrg::m_indirect[id.x].rgb;
    radianceAndDistance.rgb += min(surface.rgb, 0.9f) * irradiance * 0.15915494309f;
    PassSrg::m_output[ray] = radianceAndDistance;
}
