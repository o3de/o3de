#include <Atom/Features/SrgSemantics.azsli>
#include <scenesrg_all.srgi>
#include <Atom/Features/MeshInfo/MeshInfoBufferUtil.azsli>
#include "DiffuseProbeGridSoftwareBvh.azsli"

ShaderResourceGroup PassSrg : SRG_PerPass
{
    StructuredBuffer<SoftwareBvhNode> m_nodes;
    RWStructuredBuffer<SoftwareBvhBounds> m_bounds;
    StructuredBuffer<uint> m_primitiveIndices;
    StructuredBuffer<SoftwareBvhInstance> m_instances;
    StructuredBuffer<SoftwareBvhRefitWork> m_work;
    uint m_firstWork;
    uint m_workCount;
};

[numthreads(64, 1, 1)]
void MainCS(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= PassSrg::m_workCount)
    {
        return;
    }
    SoftwareBvhRefitWork work = PassSrg::m_work[PassSrg::m_firstWork + id.x];
    SoftwareBvhNode node = PassSrg::m_nodes[work.topologyBase + work.node];
    SoftwareBvhBounds result = (SoftwareBvhBounds)0;
    result.minimum = float3(3.402823466e+38f, 3.402823466e+38f, 3.402823466e+38f);
    result.maximum = -result.minimum;
    if (work.kind == 1)
    {
        uint left = node.first;
        uint right = PassSrg::m_nodes[work.topologyBase + left].escape;
        SoftwareBvhBounds leftBounds = PassSrg::m_bounds[work.boundsBase + left];
        SoftwareBvhBounds rightBounds = PassSrg::m_bounds[work.boundsBase + right];
        result.minimum = min(leftBounds.minimum, rightBounds.minimum);
        result.maximum = max(leftBounds.maximum, rightBounds.maximum);
    }
    else if (work.kind == 0)
    {
        MeshInfo mesh = (MeshInfo)0;
        if (!GetMeshInfoEntry(int(work.meshInfoIndex), mesh))
        {
            return;
        }
        for (uint i = 0; i < node.count; ++i)
        {
            uint triangleIndex = PassSrg::m_primitiveIndices[work.primitiveBase + node.first + i];
            uint3 indices = LoadIndex(mesh, triangleIndex);
            for (uint corner = 0; corner < 3; ++corner)
            {
                float3 position = LoadPosition(mesh, indices[corner]);
                result.minimum = min(result.minimum, position);
                result.maximum = max(result.maximum, position);
            }
        }
    }
    else
    {
        for (uint i = 0; i < node.count; ++i)
        {
            uint instanceIndex = PassSrg::m_primitiveIndices[work.primitiveBase + node.first + i];
            SoftwareBvhInstance instance = PassSrg::m_instances[instanceIndex];
            MeshInfo mesh = (MeshInfo)0;
            if (!GetMeshInfoEntry(int(instance.meshInfoIndex), mesh))
            {
                continue;
            }
            SoftwareBvhBounds localBounds = PassSrg::m_bounds[instance.boundsBase];
            float3 center = localBounds.minimum * 0.5f + localBounds.maximum * 0.5f;
            float3 extent = localBounds.maximum * 0.5f - localBounds.minimum * 0.5f;
            float4x4 transform = SceneSrg::GetObjectToWorldMatrix(mesh.m_objectIdForTransform);
            float3 worldCenter = mul(transform, float4(center, 1.0f)).xyz;
            float3 worldExtent = mul(abs((float3x3)transform), extent);
            // Conservatively include floating-point transform error, including cancellation at large world coordinates.
            float3 translation = float3(transform[0].w, transform[1].w, transform[2].w);
            float3 error = (mul(abs((float3x3)transform), abs(center) + extent) + abs(translation)) * 4.768371582e-7f + 1e-5f;
            result.minimum = min(result.minimum, worldCenter - worldExtent - error);
            result.maximum = max(result.maximum, worldCenter + worldExtent + error);
        }
    }
    if (work.kind == 0)
    {
        float3 error = max(abs(result.minimum), abs(result.maximum)) * 4.768371582e-7f + 1e-5f;
        result.minimum -= error;
        result.maximum += error;
    }
    PassSrg::m_bounds[work.boundsBase + work.node] = result;
}
