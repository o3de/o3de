// Meshlet motion-vector pass shader.
//
// PERF: hardware input-assembly. The VS reads a POSITION channel fetched through
// the hardware index buffer (post-transform vertex-cache reuse), replacing
// vertex-pull. The matching POSITION-only PSO input layout is built in
// MeshletsFeatureProcessor (InitMotionShader). Renders per-pixel screen-space
// motion for TAA / temporal upscaling via Atom's standard MeshMotionVector pass
// (DrawListTag "motion"), exactly like a standard mesh -- so the meshlet does not
// ghost when the camera or the object moves.
//
// Math mirrors MeshMotionVector.azsli (the standard mesh path):
//   motion = (currClip.xy/currClip.w - prevClip.xy/prevClip.w) * 0.5, Y flipped.
// Jitter is already baked into the current/previous view-projection matrices, so
// no explicit jitter handling is needed.

#include <Atom/Features/SrgSemantics.azsli>
#include <viewsrg_all.srgi>
// Brings in scenesrg_all.srgi + MeshletsObjectRenderSrg (vertex buffers) +
// MeshletsInstanceRenderSrg (m_objectId / GetWorldMatrix).
#include <MeshletsPerObjectRenderSrg.azsli>

struct VSInput
{
    float3 m_position : POSITION;
    // Step B (hardware instancing): SV_InstanceID indexes m_instanceObjectIds on
    // the cull-off path. 0 (and unused) on the non-instanced path.
    uint m_instanceId : SV_InstanceID;
};

struct VSOutput
{
    float4 m_position     : SV_Position;
    float3 m_worldPos     : TEXCOORD0;
    float3 m_worldPosPrev : TEXCOORD1;
};

struct PSOutput
{
    float2 m_motion : SV_Target0;   //!< R16G16_FLOAT screen-space motion vector.
};

VSOutput MeshletsMotionVectorVS(VSInput IN)
{
    VSOutput OUT;

    const float3 localPosition = IN.m_position;

    // KEEP both current AND previous object-to-world transforms (prev drives the
    // motion vector). Step B: hardware-instanced draws select objectId via
    // SV_InstanceID (when m_useInstancing != 0), so EVERY instance gets its OWN
    // prev transform -- no ghosting; the non-instanced path keeps m_objectId.
    const uint objectId = MeshletsInstanceRenderSrg::ResolveObjectId(IN.m_instanceId);
    const float4x4 worldMatrix     = SceneSrg::GetObjectToWorldMatrix(objectId);
    const float4x4 worldMatrixPrev = SceneSrg::GetObjectToWorldMatrixPrev(objectId);

    OUT.m_worldPos     = mul(worldMatrix,     float4(localPosition, 1.0)).xyz;
    OUT.m_worldPosPrev = mul(worldMatrixPrev, float4(localPosition, 1.0)).xyz;
    OUT.m_position     = mul(ViewSrg::m_viewProjectionMatrix, float4(OUT.m_worldPos, 1.0));

    return OUT;
}

PSOutput MeshletsMotionVectorPS(VSOutput IN)
{
    PSOutput OUT;

    const float4 clipPos     = mul(ViewSrg::m_viewProjectionMatrix,     float4(IN.m_worldPos, 1.0));
    const float4 clipPosPrev = mul(ViewSrg::m_viewProjectionPrevMatrix, float4(IN.m_worldPosPrev, 1.0));

    float2 motion = (clipPos.xy / clipPos.w - clipPosPrev.xy / clipPosPrev.w) * 0.5;
    // Flip Y to line up with UV coordinates (matches the standard mesh path).
    motion.y = -motion.y;

    OUT.m_motion = motion;
    return OUT;
}
