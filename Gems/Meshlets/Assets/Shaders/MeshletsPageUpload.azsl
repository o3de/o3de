// Page upload: copies one page payload from a fresh staging buffer (ReadOnly
// initial-data -- the only proven CPU->GPU path on this AMD GPU) into its pool slot.

#include <Atom/Features/SrgSemantics.azsli>

ShaderResourceGroup MeshletsPageUploadSrg : SRG_PerObject
{
    //! Staging copy of the page payload, viewed as u32 words.
    StructuredBuffer<uint> m_src;
    //! The global page pool. Bound to the frame graph's scope-backed view and
    //! compiled inside the compute pass's CompileResources (finalize mechanism).
    RWStructuredBuffer<uint> m_dstPool;
    uint m_dstSlotBase;    //!< slot * PageSlotU32s.
    uint m_payloadU32s;    //!< Payload words (after the header).
    uint4 m_header;        //!< {clusterCount, vertexCount, triangleWords, indirCount}.
};

//! One thread per destination word: [0,4) = header, [4, 4+payload) = payload copy.
[numthreads(64, 1, 1)]
void UploadPage(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint i = dispatchThreadId.x;
    const uint total = 4u + MeshletsPageUploadSrg::m_payloadU32s;
    if (i >= total)
    {
        return;
    }
    if (i < 4u)
    {
        MeshletsPageUploadSrg::m_dstPool[MeshletsPageUploadSrg::m_dstSlotBase + i] =
            MeshletsPageUploadSrg::m_header[i];
    }
    else
    {
        MeshletsPageUploadSrg::m_dstPool[MeshletsPageUploadSrg::m_dstSlotBase + i] =
            MeshletsPageUploadSrg::m_src[i - 4u];
    }
}
