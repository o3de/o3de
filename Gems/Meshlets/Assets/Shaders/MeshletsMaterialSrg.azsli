#pragma once

#include <Atom/Features/SrgSemantics.azsli>

// ----------------------------------------------------------------------------
// Per-material SRG for meshlet PBR (Phase 4).
//
// Frequency SRG_PerMaterial (space 2) -- does not collide with the meshlet's
// per-object (1, vertex buffers) / per-draw (0, object id) / per-pass (4,
// forward lighting) SRGs.
//
// Populated at runtime by MeshletsRenderObject::EnsureMaterialSrg from the
// source model's MaterialAsset (StandardPBR / BasePBR / EnhancedPBR property
// conventions). When a map is absent the corresponding flag bit is cleared and
// a 1x1 white texture is bound so the descriptor is valid; the shader then uses
// the scalar/color factor (and the interpolated vertex normal for normals).
// ----------------------------------------------------------------------------
ShaderResourceGroup MeshletsMaterialSrg : SRG_PerMaterial
{
    Texture2D m_baseColorMap;
    Texture2D m_normalMap;
    Texture2D m_metallicMap;
    Texture2D m_roughnessMap;
    Texture2D m_diffuseOcclusionMap;
    Texture2D m_specularOcclusionMap;
    Texture2D m_emissiveMap;

    Sampler m_sampler
    {
        AddressU = Wrap;
        AddressV = Wrap;
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
    };

    //! baseColor.color * baseColor.factor (rgb); alpha unused for opaque.
    float4 m_baseColor;
    //! Used only when MESHLETS_MAT_FLAG_METALLIC_MAP is NOT set.
    float  m_metallicFactor;
    //! Used only when MESHLETS_MAT_FLAG_ROUGHNESS_MAP is NOT set.
    float  m_roughnessFactor;
    //! Remap range for the roughness texture: lerp(lower, upper, tex.r).
    //! When the roughness texture is not bound these are unused.
    float  m_roughnessLowerBound;
    float  m_roughnessUpperBound;
    //! Strength multiplier applied to the tangent-space normal map's XY perturbation.
    float  m_normalFactor;
    //! Occlusion: applied as occlusion = pow(tex.r, factor) when the map is bound,
    //! else 1.0 (no occlusion). Mirrors GetOcclusionInput in OcclusionInput.azsli.
    float  m_diffuseOcclusionFactor;
    float  m_specularOcclusionFactor;
    //! Emissive: result = color * intensity * (map.rgb if bound).
    //! Pre-multiplied on the CPU when emissive.enable is true; zero otherwise so
    //! the shader can unconditionally add it without an extra branch.
    float3 m_emissiveColor;
    float  m_emissiveIntensity;
    //! Bitfield of which maps are present -- see MESHLETS_MAT_FLAG_* below.
    uint   m_flags;
};

#define MESHLETS_MAT_FLAG_BASECOLOR_MAP    (1u << 0)
#define MESHLETS_MAT_FLAG_NORMAL_MAP       (1u << 1)
#define MESHLETS_MAT_FLAG_METALLIC_MAP     (1u << 2)
#define MESHLETS_MAT_FLAG_ROUGHNESS_MAP    (1u << 3)
#define MESHLETS_MAT_FLAG_DIFFUSE_AO_MAP   (1u << 4)
#define MESHLETS_MAT_FLAG_SPECULAR_AO_MAP  (1u << 5)
#define MESHLETS_MAT_FLAG_EMISSIVE_MAP     (1u << 6)
