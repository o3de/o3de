{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "MeshletsRenderPassTemplate",
            "PassClass": "MeshletsRenderPass",
            // SP1 fix: removed the MeshletsSharedBuffer slot. Indices are now
            // bound to MeshletsObjectRenderSrg::m_indices as a per-object
            // dedicated buffer, so the render pass no longer needs the
            // SharedBuffer attachment. This eliminates the cross-pass
            // UAV-to-SRV state transition on a single shared resource that
            // was page-faulting on AMD.
            "Slots": [
                {
                    "Name": "DepthStencilInputOutput",
                    "SlotType": "InputOutput",
                    "ScopeAttachmentUsage": "DepthStencil"
                },
                {
                    "Name": "RenderTargetInputOutput",
                    "SlotType": "InputOutput",
                    "ScopeAttachmentUsage": "RenderTarget"
                }
            ],
            "Connections": []
        }
    }
}