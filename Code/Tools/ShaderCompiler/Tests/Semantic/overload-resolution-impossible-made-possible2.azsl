int make(int);
uint make(uint);

float pick(float);
int pick(int);
float3 pick(float3);
float use(float);

typealias Auto = typeof(make(0));

void main()
{
    float x = 0.5;
    Auto a = make(floor(x) + 1);  // was EC 41 in the AsError heterogeneous version, but here the simple types returned makes it ok
    float nested = use(pick(1u));
}
