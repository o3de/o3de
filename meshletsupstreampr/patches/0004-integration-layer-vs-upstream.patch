diff --git a/Gems/Atom/Feature/Common/Assets/Shaders/GpuDriven/GpuBatchBlockScan.azsl b/Gems/Atom/Feature/Common/Assets/Shaders/GpuDriven/GpuBatchBlockScan.azsl
new file mode 100644
index 00000000000..2ce183933d0
--- /dev/null
+++ b/Gems/Atom/Feature/Common/Assets/Shaders/GpuDriven/GpuBatchBlockScan.azsl
@@ -0,0 +1,42 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// Batch build pass 1: exclusive-scan each 256-wide block of per-batch counts into
+// m_batchBaseOffset (block-local), and emit each block's total into m_batchScanBlockSums.
+
+#include <scenesrg_all.srgi>
+#include <Atom/Features/GpuDriven/GpuBatchScanCommon.azsli>
+
+ShaderResourceGroup PassSrg : SRG_PerPass
+{
+    StructuredBuffer<uint> m_batchCount;           // in: per-batch counts (read-only)
+    RWStructuredBuffer<uint> m_batchBaseOffset;    // out: block-local exclusive prefix sum
+    RWStructuredBuffer<uint> m_batchScanBlockSums; // out: per-block totals
+};
+
+[numthreads(SCAN_BLOCK_SIZE, 1, 1)]
+void BlockScanCS(uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID)
+{
+    uint tid = gtid.x;
+    uint globalIdx = gid.x * SCAN_BLOCK_SIZE + tid;
+    s_scanData[tid] = (globalIdx < SceneSrg::m_gpuBatchCount) ? PassSrg::m_batchCount[globalIdx] : 0u;
+    GroupMemoryBarrierWithGroupSync();
+
+    uint original = s_scanData[tid];
+    GpuBatch_ExclusiveScanLDS(tid);
+
+    if (globalIdx < SceneSrg::m_gpuBatchCount)
+    {
+        PassSrg::m_batchBaseOffset[globalIdx] = s_scanData[tid];
+    }
+    if (tid == SCAN_BLOCK_SIZE - 1)
+    {
+        // inclusive total of this block = exclusive[last] + original[last]
+        PassSrg::m_batchScanBlockSums[gid.x] = s_scanData[tid] + original;
+    }
+}
