+                        return targetPath;
+                    }
+                    AZStd::string existing;
+                    existing.resize(static_cast<size_t>(size));
+                    AZ::IO::HandleType rh;
+                    if (io->Open(targetPath.c_str(), AZ::IO::OpenMode::ModeRead, rh))
+                    {
