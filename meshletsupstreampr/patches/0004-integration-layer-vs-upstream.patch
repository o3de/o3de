diff --git a/Gems/Atom/Feature/Common/Assets/Shaders/GpuDriven/GpuOcclusionCullPass2.azsl b/Gems/Atom/Feature/Common/Assets/Shaders/GpuDriven/GpuOcclusionCullPass2.azsl
