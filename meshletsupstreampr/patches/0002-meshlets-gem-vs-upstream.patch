-
-            //! Finding a vertex within the meshlet is done like that:
-            //!     triangleOffset = currentMeshlet.triangleOffset + meshletTrIndex * 3;
-            //!     localIndex_i = meshletTriangles[triangleOffset + i];    // i = triangle vertex index 0..2
