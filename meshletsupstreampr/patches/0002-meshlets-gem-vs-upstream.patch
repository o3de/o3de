+                    // Either the ImGui debug tab or r_meshletsFreezeCull (set by tools that
+                    // cannot depend on this gem, e.g. WDDebugView) can request the freeze.
+                    if (m_debugControls.m_freezeCullCamera || r_meshletsFreezeCull)
+                    {
