+            AZ_Error("Meshlets", false, "MeshletsRenderObject: VertexStreams section truncated");
+            return;
+        }
+        const auto* vsDescs = reinterpret_cast<const VertexStreamDescriptor*>(vsBytes.data() + sizeof(VertexStreamSubHeader));
