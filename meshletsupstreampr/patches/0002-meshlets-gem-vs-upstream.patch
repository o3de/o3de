-                        uint8_t vtxIndirectIndex[3] = {
-                            uint8_t((encodedTri >> 0) & 0xff),
-                            uint8_t((encodedTri >> 8) & 0xff),
-                            uint8_t((encodedTri >> 16) & 0xff)
-                        };
-
-                        for (uint32_t vtx = 0; vtx < 3; ++vtx)
