-            // Filling the mesh data for the meshlet library
-            mesh.vertices.resize(vtxNum);
-            for (uint32_t vtx = 0, posIdx=0, uvIdx=0; vtx < vtxNum; ++vtx, posIdx+=3, uvIdx+=2)
