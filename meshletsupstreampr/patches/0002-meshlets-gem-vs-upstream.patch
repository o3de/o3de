+{
+    "Source" : "./MeshletsForwardMeshShader.azsl",
+
+    // Phase 5 AS/triangle cull (opt-in r_meshletsMsCullAS). SEPARATE .shader from
+    // MeshletsForwardMeshShader.shader even though both compile the same .azsl source:
+    // adding the Amplification stage to THAT shader would make every DispatchMesh call
+    // through it invoke the AS unconditionally, changing the shipped default (no-cull)
+    // mesh-shader path's behavior. This PSO adds Amplification + the payload-driven
+    // MeshletsForwardPassMSCulled entry (per-triangle cull too) instead of
+    // MeshletsForwardPassMS; the pixel shader is byte-for-byte shared.
+    //
+    // Mirrors MeshletsForwardMeshShader.shader's render state exactly (reverse-Z +
+    // stencil Replace) so a mesh-shader-drawn cluster looks identical either way.
+    "DepthStencilState" :
+    {
+        "Depth" :
+        {
+            "Enable" : true,
+            "CompareFunc" : "GreaterEqual"
+        },
+        "Stencil" :
+        {
+            "Enable" : true,
+            "ReadMask" : "0x00",
+            "WriteMask" : "0xFF",
+            "FrontFace" :
+            {
+                "Func" : "Always",
+                "DepthFailOp" : "Keep",
+                "FailOp" : "Keep",
+                "PassOp" : "Replace"
+            },
+            "BackFace" :
+            {
+                "Func" : "Always",
+                "DepthFailOp" : "Keep",
+                "FailOp" : "Keep",
+                "PassOp" : "Replace"
+            }
+        }
+    },
+
+    "DrawList" : "forward",
+
+    "ProgramSettings":
+    {
+      "EntryPoints":
+      [
+        {
+          "name": "MeshletsCullClustersAS",
+          "type": "Amplification"
+        },
+        {
+          "name": "MeshletsForwardPassMSCulled",
+          "type": "Mesh"
+        },
+        {
+          "name": "MeshletsForwardMeshShaderPS",
+          "type": "Fragment"
+        }
+      ]
+    }
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsForwardPass.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsForwardPass.azsl
new file mode 100644
index 00000000000..7b1b6887e65
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsForwardPass.azsl
@@ -0,0 +1,345 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// Meshlet forward PBR pass shader.
+//
+// This shader is rendered by the STANDARD Atom ForwardPass (DrawListTag
+// "forward"). The pass binds the ForwardPassSrg (directional/projected
+// shadowmaps, tile light data, BRDF map, samplers) before submitting every
+// DrawItem in the pass, so the meshlet DrawItem automatically has access to all
+// lighting resources — exactly like a standard mesh. We only declare the
+// matching SRG and pull in the standard lighting headers.
+//
+// Output is the full 5-target MainPipeline ForwardPassOutput (diffuse,
+// specular, albedo, specularF0, normal). Direct lighting (directional +
+// punctual/tile-culled + area lights + shadows) is evaluated here; global IBL,
+// SSR, diffuse GI and multiscatter are applied later by fullscreen passes that
+// consume the albedo/specularF0/normal G-buffer outputs.
+//
+// Phase 3a: hardcoded gray dielectric material parameters. Phase 4 binds the
+// source model's actual material textures.
+//
+// PERF: the vertex shader uses hardware input-assembly like the depth/shadow/
+// motion shaders — a 5-channel layout (POSITION,NORMAL,TANGENT,BITANGENT,UV)
+// fetched through the hardware index buffer (post-transform vertex-cache reuse),
+// replacing the prior SV_VertexID -> StructuredBuffer vertex-pull. The matching
+// PSO input layout + dedicated per-attribute IA buffers are set up in
+// MeshletsFeatureProcessor (InitForwardShader / EnsureIndirectArgs).
+
+// Enable tile-based light culling (the forward pass provides m_tileLightData +
+// m_lightListRemapped). Must be set before the lighting headers are included.
+#define ENABLE_LIGHT_CULLING    1
+
+#include <Atom/Features/SrgSemantics.azsli>
+
+// ---- Shader Resource Groups ----
+// scenesrg_all.srgi is included transitively by MeshletsPerObjectRenderSrg.azsli.
+#include <viewsrg_all.srgi>
+#include <MeshletsPerObjectRenderSrg.azsli>
+
+// Standard forward pass SRG (SRG_PerPass). #pragma once-guarded, so a second
+// transitive include from the lighting headers is harmless. The PerPass SRG
+// carries no ShaderVariantFallback, so it does not collide with the PerDraw
+// fallback SRG (MeshletsInstanceRenderSrg) that stores the shader-option key.
+#include <Atom/Features/Pipeline/Forward/ForwardPassSrg.azsli>
+
+// Per-material SRG (SRG_PerMaterial) — the source model's PBR textures + factors,
+// extracted at runtime. Bound on the forward DrawItem by the feature processor.
+#include <MeshletsMaterialSrg.azsli>
+
+// Color-space conversion (LinearSrgb -> AcesCg). Atom's PBR pipeline does its
+// lighting math in AcesCg working space; a baseColor texture sampled raw is in
+// linear-sRGB and would feed the wrong color space into the BRDF. The standard
+// Atom material path applies this conversion in GetBaseColorInput — see
+// BaseColorInput.azsli line 55. We mirror that exactly.
+#include <Atom/Features/ColorManagement/TransformColor.azsli>
+
+// Declares the OpacityMode enum + o_opacity_mode shader option (defaults to
+// Opaque). The shadow headers pulled in below reference these to decide whether
+// to sample the fullscreen shadow buffer. Normally provided by the material
+// system; a non-material shader must include it explicitly.
+#include <Atom/Features/PBR/AlphaUtils.azsli>
+
+// Standard PBR lighting. Pulls in Surface, LightingData, the directional /
+// punctual / area light loops, the BRDF, GetPbrLightingOutput(), and the
+// ApplyDirectLighting() / ApplyDecals() wrappers.
+#include <Atom/Features/PBR/Lighting/StandardLighting.azsli>
+#include <Atom/Features/PBR/Microfacet/Fresnel.azsli>
+
+// 5-target MainPipeline forward output. Do NOT define UNIFIED_FORWARD_OUTPUT
+// (that single-target layout is only used by the Mobile / LowEnd / MultiView
+// pipelines).
+#include <Atom/Features/Pipeline/Forward/ForwardPassOutput.azsli>
+
+struct VSInput
+{
+    float3 m_position  : POSITION;
+    float3 m_normal    : NORMAL;
+    float4 m_tangent   : TANGENT;
+    float3 m_bitangent : BITANGENT;
+    float2 m_uv        : UV;
+    // Step B (hardware instancing): SV_InstanceID indexes m_instanceObjectIds on
+    // the cull-off path. 0 (and unused) on the non-instanced path.
+    uint   m_instanceId : SV_InstanceID;
+};
+
+struct VSOutput
+{
+    float4 m_position : SV_Position;
+    float3 m_normal : NORMAL;
+    float3 m_tangent : TANGENT;
+    float3 m_bitangent : BITANGENT;
+    float3 m_worldPosition : UV0;
+    float2 m_uv : UV1;
+    //! Debug: cluster (meshlet) id resolved in the VS from the linear index.
+    //! nointerpolation — it's a per-primitive integer, not something to lerp.
+    nointerpolation uint m_clusterId : UV2;
+};
+
+//! Transform vertex normal/tangent/bitangent into world space.
+void ConstructMeshletTBN(
+    float3 vertexNormal, float4 vertexTangent, float3 vertexBitangent,
+    float4x4 localToWorld, float3x3 localToWorldInverseTranspose,
+    out float3 normalWS, out float3 tangentWS, out float3 bitangentWS)
+{
+    normalWS = normalize(mul(localToWorldInverseTranspose, vertexNormal));
+    tangentWS = normalize(mul(localToWorld, float4(vertexTangent.xyz, 0)).xyz);
+    bitangentWS = normalize(mul(localToWorld, float4(vertexBitangent, 0)).xyz);
+}
+
+VSOutput MeshletsForwardPassVS(VSInput IN)
+{
+    VSOutput OUT;
+
+    // Zero-init all interpolants so no field is left uninitialized.
+    OUT.m_position      = float4(0, 0, 0, 1);
+    OUT.m_normal        = float3(0, 0, 1);
+    OUT.m_tangent       = float3(1, 0, 0);
+    OUT.m_bitangent     = float3(0, 1, 0);
+    OUT.m_worldPosition = float3(0, 0, 0);
+    OUT.m_uv            = float2(0, 0);
+    // Debug cluster id: the old SV_VertexID-based GetClusterId was already only an
+    // approximation, and there is no SV_VertexID under hardware IA. Keep it a benign
+    // constant (the meshlet-debug-color PS path stays functional, just uniform color).
+    OUT.m_clusterId     = 0u;
+
+    // Hardware input-assembly: attributes come straight from the bound vertex streams
+    // (POSITION,NORMAL,TANGENT,BITANGENT,UV) — no SV_VertexID / StructuredBuffer pulls.
+    float3 localPosition = IN.m_position;
+
+    // Step B: hardware-instanced draws select objectId via SV_InstanceID (when
+    // m_useInstancing != 0); the non-instanced path keeps the per-draw m_objectId.
+    // Both the world matrix and its inverse-transpose (for normals under non-uniform
+    // scale) use this objectId.
+    uint objectId = MeshletsInstanceRenderSrg::ResolveObjectId(IN.m_instanceId);
+    float4x4 objectToWorld = SceneSrg::GetObjectToWorldMatrix(objectId);
+    float3x3 objectToWorldIT = SceneSrg::GetObjectToWorldInverseTransposeMatrix(objectId);
+
+    OUT.m_worldPosition = mul(objectToWorld, float4(localPosition, 1.0)).xyz;
+    OUT.m_position = mul(ViewSrg::m_viewProjectionMatrix, float4(OUT.m_worldPosition, 1.0));
+
+    ConstructMeshletTBN(
+        IN.m_normal,
+        IN.m_tangent,
+        IN.m_bitangent,
+        objectToWorld, objectToWorldIT,
+        OUT.m_normal, OUT.m_tangent, OUT.m_bitangent);
+
+    OUT.m_uv = IN.m_uv;
+
+    return OUT;
+}
+
+ForwardPassOutput MeshletsForwardPassPS(VSOutput IN)
+{
+    // ---------------- Debug: flat per-cluster (meshlet) color ----------------
+    // When enabled, bypass PBR entirely and emit a flat unlit color keyed off the
+    // cluster id so the meshlet decomposition is directly visible. Output as
+    // emissive (specular target) with zero albedo/diffuse/F0 so IBL/SSR passes add
+    // nothing — the composited result is the flat color.
+    if (MeshletsObjectRenderSrg::m_meshletDebugColor != 0u)
+    {
+        const float3 clusterColor = MeshletsObjectRenderSrg::MeshletDebugColor(IN.m_clusterId);
+        ForwardPassOutput dbg = (ForwardPassOutput)0;
+        dbg.m_diffuseColor  = float4(0.0, 0.0, 0.0, -1.0);   // a=-1 disables SSS
+        dbg.m_specularColor = float4(clusterColor, 0.0);     // emissive-add path
+        dbg.m_albedo        = float4(0.0, 0.0, 0.0, 1.0);
+        dbg.m_specularF0    = float4(0.0, 0.0, 0.0, 0.0);
+        dbg.m_normal        = float4(normalize(IN.m_normal) * 0.5 + 0.5, 0.0);
+        return dbg;
+    }
+
+    float3 views[MAX_SHADING_VIEWS];
+    views[0] = ViewSrg::m_worldPosition.xyz;   // Single view for the forward pass.
+
+    // ---------------- Sample the material (Phase 4) ----------------
+    // Combine rules below mirror StandardPBR's *Input.azsli convention exactly,
+    // so a meshlet material looks identical to a standard mesh using the same
+    // MaterialAsset:
+    //   baseColor : color*factor (CPU) THEN * texture.rgb (Multiply blend)
+    //   metallic  : texture.r           when bound, else factor
+    //   roughness : lerp(lower, upper, texture.r) when bound, else factor
+    //   normal    : XY swizzled to YX, Z reconstructed (BC5 normal map convention),
+    //               XY scaled by normalFactor; falls back to vertex normal otherwise.
+    const uint matFlags = MeshletsMaterialSrg::m_flags;
+    const float2 uv = IN.m_uv;
+
+    // Base color: m_baseColor.rgb already holds color.rgb * baseColor.factor from
+    // the CPU. When the texture is bound, sample it and convert into Atom's AcesCg
+    // working color space before applying the Multiply blend (this matches
+    // GetBaseColorInput + BlendBaseColor in StandardPBR exactly — see
+    // BaseColorInput.azsli line 55).
+    real3 baseColor = (real3)MeshletsMaterialSrg::m_baseColor.rgb;
+    if (matFlags & MESHLETS_MAT_FLAG_BASECOLOR_MAP)
+    {
+        real3 sampledAlbedo = (real3)MeshletsMaterialSrg::m_baseColorMap.Sample(MeshletsMaterialSrg::m_sampler, uv).rgb;
+        sampledAlbedo = LinearSrgb_To_AcesCg(sampledAlbedo);
+        baseColor *= sampledAlbedo;
+    }
+
+    // Metallic: texture takes precedence over factor when the map is bound — they
+    // are NOT multiplied. (Multiplying made everything dielectric whenever
+    // metallic.factor=0, even on areas the texture marks as metal.)
+    real metallic;
+    if (matFlags & MESHLETS_MAT_FLAG_METALLIC_MAP)
+    {
+        metallic = (real)MeshletsMaterialSrg::m_metallicMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
+    }
+    else
+    {
+        metallic = (real)MeshletsMaterialSrg::m_metallicFactor;
+    }
+
+    // Roughness: with a texture, remap by lerp(lower, upper, tex.r) per StandardPBR.
+    // (Multiplying factor*tex.r capped roughness too low and made everything mirror-
+    // smooth — that was the "chrome" look.)
+    real roughness;
+    if (matFlags & MESHLETS_MAT_FLAG_ROUGHNESS_MAP)
+    {
+        const real roughR = (real)MeshletsMaterialSrg::m_roughnessMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
+        roughness = lerp(
+            (real)MeshletsMaterialSrg::m_roughnessLowerBound,
+            (real)MeshletsMaterialSrg::m_roughnessUpperBound,
+            roughR);
+    }
+    else
+    {
+        roughness = (real)MeshletsMaterialSrg::m_roughnessFactor;
+    }
+
+    // Normal: BC5/RG normal map convention used by Atom. Sample .rg, decode to
+    // [-1,1], swap to (Y,X) so it matches the engine-wide encoding, scale XY by
+    // normalFactor, reconstruct Z = sqrt(1 - x^2 - y^2). Transform tangent-space
+    // -> world via the TBN built in the vertex shader.
+    real3 normalWS = normalize((real3)IN.m_normal);
+    if (matFlags & MESHLETS_MAT_FLAG_NORMAL_MAP)
+    {
+        real2 sampleRG = (real2)MeshletsMaterialSrg::m_normalMap.Sample(MeshletsMaterialSrg::m_sampler, uv).rg * 2.0 - 1.0;
+        real2 tangentXY = sampleRG.yx;
+        tangentXY *= (real)MeshletsMaterialSrg::m_normalFactor;
+        const real tangentZ = max(sqrt(saturate(1.0 - dot(tangentXY, tangentXY))), 0.01);
+        const real3 T = normalize((real3)IN.m_tangent);
+        const real3 B = normalize((real3)IN.m_bitangent);
+        const real3 N = normalize((real3)IN.m_normal);
+        normalWS = normalize(tangentXY.x * T + tangentXY.y * B + tangentZ * N);
+    }
+
+    // Ambient occlusion: GetOcclusionInput in OcclusionInput.azsli uses
+    //   occlusion = pow(tex.r, factor) when the texture is bound, else 1.0.
+    // Without AO, ambient + specular lighting fills crevices and the surface
+    // looks brighter / more reflective than the standard mesh — exactly the
+    // "still reflective" symptom.
+    real diffuseAO = 1.0;
+    if (matFlags & MESHLETS_MAT_FLAG_DIFFUSE_AO_MAP)
+    {
+        const real aoR = (real)MeshletsMaterialSrg::m_diffuseOcclusionMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
+        diffuseAO = pow(aoR, (real)MeshletsMaterialSrg::m_diffuseOcclusionFactor);
+    }
+    real specularAO = 1.0;
+    if (matFlags & MESHLETS_MAT_FLAG_SPECULAR_AO_MAP)
+    {
+        const real aoR = (real)MeshletsMaterialSrg::m_specularOcclusionMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
+        specularAO = pow(aoR, (real)MeshletsMaterialSrg::m_specularOcclusionFactor);
+    }
+
+    // Emissive: pre-multiplied color * intensity is in m_emissiveColor (zero
+    // when the material's emissive.enable is false). Modulated by the map if bound.
+    real3 emissive = (real3)MeshletsMaterialSrg::m_emissiveColor * (real)MeshletsMaterialSrg::m_emissiveIntensity;
+    if (matFlags & MESHLETS_MAT_FLAG_EMISSIVE_MAP)
+    {
+        emissive *= (real3)MeshletsMaterialSrg::m_emissiveMap.Sample(MeshletsMaterialSrg::m_sampler, uv).rgb;
+    }
+
+    // ---------------- Build the surface ----------------
+    Surface surface = (Surface)0;
+    surface.position = IN.m_worldPosition;
+    surface.vertexNormal = normalize((real3)IN.m_normal);
+    surface.normal = normalWS;
+
+    // Lit by all lighting channels until per-object channels are wired up.
+    surface.lightingChannels = 0xFFFFFFFF;
+
+    // specularF0Factor 0.5 maps to the standard ~0.04 dielectric F0.
+    surface.SetAlbedoAndSpecularF0(baseColor, 0.5, metallic);
+    surface.roughnessLinear = roughness;
+    surface.CalculateRoughnessA();
+
+    surface.emissiveLighting = emissive;
+    surface.diffuseAmbientOcclusion = diffuseAO;
+    surface.specularOcclusion = specularAO;
+
+    // ---------------- Initialize lighting data ----------------
+    // Mirrors InitializeLightingData_StandardPBR exactly:
+    //   1) BasePBR Init  (zeros, Fresnel response, BRDF map sample, multiscatter)
+    //   2) Copy surface.emissiveLighting + AO into lightingData
+    //
+    // The AO copies are essential. LightingData::Init() initializes both AO
+    // fields to 1.0, and FinalizeLighting() multiplies the accumulated direct
+    // lighting by them. Without the copy, our texture-sampled AO never reaches
+    // the lighting math and the surface looks brighter / more reflective than
+    // the standard mesh — that was the "still shiny" symptom.
+    LightingData lightingData;
+    lightingData.Init(surface.position, surface.GetSpecularNormal(), surface.roughnessLinear, views);
+    lightingData.specularResponse =
+        FresnelSchlickWithRoughness(lightingData.GetSpecularNdotV(), surface.GetSpecularF0(), surface.roughnessLinear);
+    lightingData.diffuseResponse = 1.0 - lightingData.specularResponse;
+    lightingData.CalculateMultiscatterCompensation(surface.GetSpecularF0(), o_specularF0_enableMultiScatterCompensation);
+    lightingData.emissiveLighting = surface.emissiveLighting;
+    lightingData.diffuseAmbientOcclusion = surface.diffuseAmbientOcclusion;
+    lightingData.specularOcclusion = surface.specularOcclusion;
+
+    // ---------------- Tile light-culling iterator ----------------
+    LightCullingTileIterator tileIterator;
+#if ENABLE_LIGHT_CULLING
+    tileIterator.Init(IN.m_position, PassSrg::m_lightListRemapped, PassSrg::m_tileLightData);
+#else
+    tileIterator.InitNoCulling();
+#endif
+
+    // ---------------- Direct lighting ----------------
+    // Directional + punctual (tile-culled) + area lights + shadows.
+    // Global IBL / multiscatter is applied later by fullscreen passes that read
+    // the albedo / specularF0 / normal G-buffer outputs below.
+    ApplyDirectLighting(surface, lightingData, IN.m_position, tileIterator);
+
+    lightingData.FinalizeLighting();
+
+    // ---------------- Pack into the 5-target forward output ----------------
+    PbrLightingOutput pbr = GetPbrLightingOutput(surface, lightingData, 1.0);
+
+    ForwardPassOutput OUT;
+    OUT.m_diffuseColor = pbr.m_diffuseColor;
+    OUT.m_diffuseColor.a = -1;   // Disable subsurface scattering.
+    OUT.m_specularColor = pbr.m_specularColor;
+    OUT.m_specularColor.rgb += lightingData.emissiveLighting;
+    OUT.m_albedo = pbr.m_albedo;
+    OUT.m_specularF0 = pbr.m_specularF0;
+    OUT.m_normal = pbr.m_normal;
+
+    return OUT;
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsForwardPass.shader b/Gems/Meshlets/Assets/Shaders/MeshletsForwardPass.shader
new file mode 100644
index 00000000000..c7e5da1b88b
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsForwardPass.shader
@@ -0,0 +1,57 @@
+{
+    "Source" : "./MeshletsForwardPass.azsl",
+
+    // Mirrors the standard MainPipeline forward shader state
+    // (ForwardPass_StandardLighting.shader.template) so meshlets behave
+    // identically to standard meshes:
+    //  - reverse-Z depth test (GreaterEqual)
+    //  - stencil Replace writes the per-draw stencil ref (UseIBLSpecularPass |
+    //    UseDiffuseGIPass = 0x83, set on the DrawItem) so the downstream
+    //    Reflections and DiffuseGlobalIllumination fullscreen passes process
+    //    meshlet pixels.
+    "DepthStencilState" :
+    {
+        "Depth" :
+        {
+            "Enable" : true,
+            "CompareFunc" : "GreaterEqual"
+        },
+        "Stencil" :
+        {
+            "Enable" : true,
+            "ReadMask" : "0x00",
+            "WriteMask" : "0xFF",
+            "FrontFace" :
+            {
+                "Func" : "Always",
+                "DepthFailOp" : "Keep",
+                "FailOp" : "Keep",
+                "PassOp" : "Replace"
+            },
+            "BackFace" :
+            {
+                "Func" : "Always",
+                "DepthFailOp" : "Keep",
+                "FailOp" : "Keep",
+                "PassOp" : "Replace"
+            }
+        }
+    },
+
+    "DrawList" : "forward",
+
+    "ProgramSettings":
+    {
+      "EntryPoints":
+      [
+        {
+          "name": "MeshletsForwardPassVS",
+          "type": "Vertex"
+        },
+        {
+          "name": "MeshletsForwardPassPS",
+          "type": "Fragment"
+        }
+      ]
+    }
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsMaterialSrg.azsli b/Gems/Meshlets/Assets/Shaders/MeshletsMaterialSrg.azsli
new file mode 100644
index 00000000000..968c54b85ed
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsMaterialSrg.azsli
@@ -0,0 +1,76 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+#pragma once
+
+#include <Atom/Features/SrgSemantics.azsli>
+
+// ----------------------------------------------------------------------------
+// Per-material SRG for meshlet PBR (Phase 4).
+//
+// Frequency SRG_PerMaterial (space 2) — does not collide with the meshlet's
+// per-object (1, vertex buffers) / per-draw (0, object id) / per-pass (4,
+// forward lighting) SRGs.
+//
+// Populated at runtime by MeshletsRenderObject::EnsureMaterialSrg from the
+// source model's MaterialAsset (StandardPBR / BasePBR / EnhancedPBR property
+// conventions). When a map is absent the corresponding flag bit is cleared and
+// a 1x1 white texture is bound so the descriptor is valid; the shader then uses
+// the scalar/color factor (and the interpolated vertex normal for normals).
+// ----------------------------------------------------------------------------
+ShaderResourceGroup MeshletsMaterialSrg : SRG_PerMaterial
+{
+    Texture2D m_baseColorMap;
+    Texture2D m_normalMap;
+    Texture2D m_metallicMap;
+    Texture2D m_roughnessMap;
+    Texture2D m_diffuseOcclusionMap;
+    Texture2D m_specularOcclusionMap;
+    Texture2D m_emissiveMap;
+
+    Sampler m_sampler
+    {
+        AddressU = Wrap;
+        AddressV = Wrap;
+        MinFilter = Linear;
+        MagFilter = Linear;
+        MipFilter = Linear;
+    };
+
+    //! baseColor.color * baseColor.factor (rgb); alpha unused for opaque.
+    float4 m_baseColor;
+    //! Used only when MESHLETS_MAT_FLAG_METALLIC_MAP is NOT set.
+    float  m_metallicFactor;
+    //! Used only when MESHLETS_MAT_FLAG_ROUGHNESS_MAP is NOT set.
+    float  m_roughnessFactor;
+    //! Remap range for the roughness texture: lerp(lower, upper, tex.r).
+    //! When the roughness texture is not bound these are unused.
+    float  m_roughnessLowerBound;
+    float  m_roughnessUpperBound;
+    //! Strength multiplier applied to the tangent-space normal map's XY perturbation.
+    float  m_normalFactor;
+    //! Occlusion: applied as occlusion = pow(tex.r, factor) when the map is bound,
+    //! else 1.0 (no occlusion). Mirrors GetOcclusionInput in OcclusionInput.azsli.
+    float  m_diffuseOcclusionFactor;
+    float  m_specularOcclusionFactor;
+    //! Emissive: result = color * intensity * (map.rgb if bound).
+    //! Pre-multiplied on the CPU when emissive.enable is true; zero otherwise so
+    //! the shader can unconditionally add it without an extra branch.
+    float3 m_emissiveColor;
+    float  m_emissiveIntensity;
+    //! Bitfield of which maps are present — see MESHLETS_MAT_FLAG_* below.
+    uint   m_flags;
+};
+
+#define MESHLETS_MAT_FLAG_BASECOLOR_MAP    (1u << 0)
+#define MESHLETS_MAT_FLAG_NORMAL_MAP       (1u << 1)
+#define MESHLETS_MAT_FLAG_METALLIC_MAP     (1u << 2)
+#define MESHLETS_MAT_FLAG_ROUGHNESS_MAP    (1u << 3)
+#define MESHLETS_MAT_FLAG_DIFFUSE_AO_MAP   (1u << 4)
+#define MESHLETS_MAT_FLAG_SPECULAR_AO_MAP  (1u << 5)
+#define MESHLETS_MAT_FLAG_EMISSIVE_MAP     (1u << 6)
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsMeshRenderSrg.azsli b/Gems/Meshlets/Assets/Shaders/MeshletsMeshRenderSrg.azsli
new file mode 100644
index 00000000000..f981966dcce
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsMeshRenderSrg.azsli
@@ -0,0 +1,291 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+#pragma once
+
+// ----------------------------------------------------------------------------
+// SRGs for the HARDWARE MESH-SHADER meshlet render path (Phase 5).
+//
+// Deliberately SEPARATE from MeshletsPerObjectRenderSrg.azsli (the VS/vertex-pull
+// path) so the mesh-shader shaders are fully isolated from the existing 5 render
+// shaders — no shared-SRG layout churn, no risk to the vertex-pull path.
+//
+// The mesh shader runs ONE threadgroup per cluster (DispatchMesh(clusterCount,1,1)),
+// reads that cluster's descriptor, transforms its vertices, and emits its triangles.
+// The cluster descriptor + triangle + indirection buffers already exist on the GPU
+// (created in MeshletsRenderObjectPackInit for the compute path); the feature
+// processor binds them to MeshletsMeshObjectSrg. The decode mirrors the compute
+// reference in MeshletsCompute.azsl (GetGlobalVertexIndicesAndTriOffset).
+// ----------------------------------------------------------------------------
+
+#include <scenesrg_all.srgi>
+
+// ClusterBoundsRecord (sphere + backface cone) + the pure frustum/cone/HiZ cull
+// math -- shared with the compute GPU-cull path (MeshletsCull.azsl). Used by
+// MeshletsCullClustersAS (Phase 5, opt-in r_meshletsMsCullAS); dead-stripped from
+// the default (non-AS) MeshletsForwardPassMS entry point.
+#include <MeshletsClusterCullMath.azsli>
+
+//! Per-mesh, re-based cluster descriptor (mesh-local offsets). Layout matches the
+//! ClusterDescriptor / MeshletDescriptor used everywhere else in the gem.
+struct MeshletDescriptor
+{
+    uint m_vertexOffset;      //!< Into m_meshletsIndicesLookup (uint steps).
+    uint m_triangleOffset;    //!< Into m_meshletsTriangles (uint steps; one uint = 3x8-bit).
+    uint m_vertexCount;       //!< Vertices in this cluster (<= 128).
+    uint m_triangleCount;     //!< Triangles in this cluster (<= 256).
+};
+
+// ----------------------------------------------------------------------------
+// Per-draw (per-instance): the objectId used to fetch this instance's transform
+// from the scene-wide arrays. Non-instanced path for the first mesh-shader slice.
+// ----------------------------------------------------------------------------
+ShaderResourceGroup MeshletsMeshInstanceSrg : SRG_PerDraw
+{
+    uint m_objectId;
+
+    // ---- Phase 5 AS/triangle cull (opt-in r_meshletsMsCullAS) ----
+    // Per-instance cull params consumed ONLY by MeshletsCullClustersAS. Unused (dead-
+    // stripped) by the default MeshletsForwardPassMS entry point, so their presence
+    // here is layout-only for that path -- byte-identical rendered output when the
+    // AS-cull PSO isn't the one bound. Mirrors MeshletsCullSrg's per-instance fields
+    // (MeshletsCull.azsl) so the AS composes the same MeshletsClusterCullMath.azsli
+    // functions the same way.
+    float4 m_worldRow0;
+    float4 m_worldRow1;
+    float4 m_worldRow2;
+    float4 m_frustumPlanes[6];
+    float4 m_cameraPosition;
+    row_major float4x4 m_worldToClip;
+    //! The last-completed slot of the persistent HiZ pyramid (previous frame's depth,
+    //! reduced), bound by UpdateMeshShaderCullInstance when the HiZ debug toggle is on.
+    //! Left unbound otherwise -- GetDimensions then reads 0x0 and the HiZ test safely
+    //! no-ops, same "optional" contract as MeshletsCullSrg::m_hiZTexture.
+    Texture2D<float> m_hiZTexture;
+    uint m_doFrustumCull;
+    uint m_doConeCull;
+    uint m_doHiZCull;
+
+    // ---- Phase 6 cluster-DAG cut (opt-in r_meshletsDagLod) ----
+    //! Render-target size in pixels. Also feeds the per-triangle micro/big-triangle
+    //! gates (replacing their old fixed 1080p reference when nonzero). Set every
+    //! frame by UpdateMeshShaderCullInstance regardless of the DAG toggle.
+    float2 m_viewportSize;
+    //! cot(FovY/2) * viewportHeight * 0.5 — the pure-projection pixel scale for
+    //! MeshletsDagProjectedErrorPx (rotation-independent).
+    float m_dagProjScale;
+    //! Cut threshold in pixels (r_meshletsDagErrorPx).
+    float m_dagErrorPx;
+    //! 0 = cut disabled: only LEAF clusters (< MeshletsMeshObjectSrg::m_leafClusterCount)
+    //! are drawable, so interior DAG clusters can never double-draw even while the
+    //! cut constants are not yet valid (creation frames, toggle transitions).
+    uint m_doDagCut;
+
+    // ---- Two-pass occlusion (opt-in r_meshletsTwoPassOcclusion) ----
+    //! Per-cluster visibility ledger: the m_frameId of the last frame each cluster
+    //! was dispatched. Frame-counter encoding => no per-frame clear pass. UAV,
+    //! written only by the AS in visMode 1/2; bound (non-null) ONLY on the depth
+    //! (pass 1) and late-depth (pass 2) instance SRGs -- forward/motion/shadow run
+    //! visMode 0 and never touch it.
+    RWStructuredBuffer<uint> m_clusterVisFrame;
+    //! Monotonic frame counter (wrap-safe: equality test only).
+    uint m_frameId;
+    //! 0 = ledger untouched; 1 = pass 1 (prev-frame HiZ; record every dispatched
+    //! cluster); 2 = pass 2 (skip clusters already recorded this frame, test the
+    //! rest against THIS frame's pyramid, record its own survivors).
+    uint m_visMode;
+}
+
+// ----------------------------------------------------------------------------
+// Per-object: cluster + vertex data shared by every instance of this mesh.
+//
+// Vertex streams are StructuredBuffer<T> (not typed Buffer<T>) for the same
+// AMD/DX12 NumElements=1 reason documented in MeshletsPerObjectRenderSrg.azsli.
+// ----------------------------------------------------------------------------
+ShaderResourceGroup MeshletsMeshObjectSrg : SRG_PerObject
+{
+    uint m_vertexCount;          //!< Total mesh vertices (bounds clamp).
+    uint m_clusterCount;         //!< Clusters the AS tests: leaf count, or the FULL
+                                 //!< leaf+interior DAG range when the DAG cut is active.
+    uint m_meshletDebugColor;    //!< 0 = PBR, 1 = flat per-cluster color, 2 = DAG level color.
+    uint m_leafClusterCount;     //!< Phase 6: leaf-only count (== m_clusterCount for v2
+                                 //!< packs; was m_pad0). The AS refuses interior clusters
+                                 //!< whenever the DAG cut is off.
+
+    //! Per-cluster descriptors, re-based to mesh-local offsets. Indexed by SV_GroupID.
+    StructuredBuffer<MeshletDescriptor> m_meshletsDescriptors;
+
+    //! Per-cluster triangle lists: one uint = 3x8-bit cluster-local vertex indices
+    //! (top byte unused). Slice for cluster c starts at descriptor.m_triangleOffset.
+    //! StructuredBuffer (not typed Buffer<uint>) — the typed-buffer SRV path mis-sets
+    //! NumElements on this AMD/DX12 combo (see MeshletsPerObjectRenderSrg.azsli).
+    StructuredBuffer<uint> m_meshletsTriangles;
+
+    //! Cluster-local vertex index -> mesh global vertex index. Slice for cluster c
+    //! starts at descriptor.m_vertexOffset.
+    StructuredBuffer<uint> m_meshletsIndicesLookup;
+
+    //! Per-cluster bounds (sphere + backface cone), indexed by the SAME cluster id
+    //! as m_meshletsDescriptors (mesh-local, re-based). Read ONLY by
+    //! MeshletsCullClustersAS's per-cluster cull test; unused by the default MS entry.
+    StructuredBuffer<ClusterBoundsRecord> m_clusterBounds;
+
+    //! Phase 6 cluster DAG (pack v3): per-cluster cut records, parallel to
+    //! m_meshletsDescriptors (leaf-first). Unbound for v2 packs — reads then return
+    //! zeros (selfError 0 => reads as "leaf"), and the cut is never enabled anyway.
+    StructuredBuffer<MeshletDagNodeRecord> m_dagNodes;
+
+    // ---- Phase 7 streaming (r_meshletsStreaming; v4 packs, AS path only) ----
+    //! 0 = monolithic fetch; 1 = every AS-path cluster fetches from the page pool.
+    //! The feature processor sets 1 ONLY once all of this mesh's always-resident
+    //! (interior) pages are uploaded, so a mapped interior always exists as the
+    //! coarse fallback.
+    uint m_pagedMode;
+    //! Phase 4 VRAM reclaim: 1 = this mesh has NO monolithic geometry buffers
+    //! (r_meshletsStreamingExclusive at load). Until m_pagedMode goes live the AS
+    //! must reject every cluster — a monolithic fallback fetch would read null SRVs.
+    uint m_pagedExclusive;
+    //! The single global page pool: fixed PageSlotU32s-word slots, layout
+    //! {header4}{PagedClusterRecord[clusterCount] as 4xu32}{triWords}{indirection}
+    //! {pos|norm|tan|bitan|uv floats as u32 bits}. See MeshletPackFormat.h.
+    StructuredBuffer<uint> m_pagePool;
+    //! Per-cluster paged map, rebuilt by the CPU on any residency change:
+    //!   [31] group-complete: leaf = every page of my simplification group's leaves
+    //!        is resident; interior (level-1) = my LEAF children's group complete;
+    //!        interior (level-2+) = always 1 (children are always-resident).
+    //!   [30] valid: this cluster's own page is resident (slot/local meaningful).
+    //!   [29:8] slot, [7:0] page-local cluster index.
+    StructuredBuffer<uint> m_pagedClusterMap;
+
+    //! Mesh vertex streams (indexed by the global mesh vertex index).
+    StructuredBuffer<float>  m_positions;   //!< 3 floats/vertex.
+    StructuredBuffer<float>  m_normals;     //!< 3 floats/vertex.
+    //! w = bitangent winding sign. The mesh-shader path reconstructs the bitangent
+    //! as sign * cross(N, T) in the pixel shader, so there is deliberately NO
+    //! m_bitangents stream here: azslc runs with --strip-unused-srgs, and an unused
+    //! member would be stripped from the layout while C++ still bound it, failing
+    //! the whole MeshletsMeshObjectSrg build (same trap documented on m_clusterBounds).
+    StructuredBuffer<float4> m_tangents;    //!< 1 float4/vertex (w = winding).
+    StructuredBuffer<float2> m_uvs;         //!< 1 float2/vertex.
+
+    float3 GetPosition(uint vertexIndex)
+    {
+        uint safe = (m_vertexCount > 0u) ? min(vertexIndex, m_vertexCount - 1u) : vertexIndex;
+        uint i = safe * 3u;
+        return float3(m_positions[i], m_positions[i + 1u], m_positions[i + 2u]);
+    }
+
+    float3 GetNormal(uint vertexIndex)
+    {
+        uint safe = (m_vertexCount > 0u) ? min(vertexIndex, m_vertexCount - 1u) : vertexIndex;
+        uint i = safe * 3u;
+        return float3(m_normals[i], m_normals[i + 1u], m_normals[i + 2u]);
+    }
+
+    float4 GetTangent(uint vertexIndex)
+    {
+        uint safe = (m_vertexCount > 0u) ? min(vertexIndex, m_vertexCount - 1u) : vertexIndex;
+        return m_tangents[safe];
+    }
+
+    float2 GetUV(uint vertexIndex)
+    {
+        uint safe = (m_vertexCount > 0u) ? min(vertexIndex, m_vertexCount - 1u) : vertexIndex;
+        return m_uvs[safe];
+    }
+
+    // ---- Phase 7 paged fetch helpers (AS-culled MS entries only) ----
+    // MUST equal AZ::Meshlets::PageSlotU32s (MeshletPackFormat.h):
+    // 4 + 16*4 + 16*256 + 16*128 + 16*128*15.
+    #define MESHLETS_PAGE_SLOT_U32S 36932
+
+    //! Resolved view of one paged cluster: absolute pool word offsets.
+    struct MeshletsPagedCluster
+    {
+        uint m_valid;
+        uint m_triAt;         //!< First triangle word of THIS cluster.
+        uint m_indirAt;       //!< First indirection entry of THIS cluster.
+        uint m_posAt;         //!< Page vertex-stream bases (index with page-local ids).
+        uint m_normAt;
+        uint m_tanAt;
+        uint m_bitanAt;
+        uint m_uvAt;
+    };
+
+    MeshletsPagedCluster GetPagedCluster(uint clusterId)
+    {
+        MeshletsPagedCluster v = (MeshletsPagedCluster)0;
+        const uint map = m_pagedClusterMap[clusterId];
+        v.m_valid = (map >> 30) & 1u;
+        if (v.m_valid == 0u)
+        {
+            return v;
+        }
+        const uint slot  = (map >> 8) & 0x3FFFFFu;
+        const uint local = map & 0xFFu;
+        const uint base  = slot * MESHLETS_PAGE_SLOT_U32S;
+        const uint pageClusterCount = m_pagePool[base + 0];
+        const uint pageVertexCount  = m_pagePool[base + 1];
+        const uint pageTriWords     = m_pagePool[base + 2];
+        const uint pageIndirCount   = m_pagePool[base + 3];
+        const uint recsAt = base + 4u;
+        const uint rec = recsAt + local * 4u;
+        const uint trisAt  = recsAt + pageClusterCount * 4u;
+        const uint indirAt = trisAt + pageTriWords;
+        const uint posAt   = indirAt + pageIndirCount;
+        v.m_triAt   = trisAt + m_pagePool[rec + 0];
+        v.m_indirAt = indirAt + m_pagePool[rec + 2];
+        v.m_posAt   = posAt;
+        v.m_normAt  = posAt   + 3u * pageVertexCount;
+        v.m_tanAt   = v.m_normAt  + 3u * pageVertexCount;
+        v.m_bitanAt = v.m_tanAt   + 4u * pageVertexCount;
+        v.m_uvAt    = v.m_bitanAt + 3u * pageVertexCount;
+        return v;
+    }
+
+    uint   GetPagedTriangleWord(MeshletsPagedCluster v, uint t) { return m_pagePool[v.m_triAt + t]; }
+    uint   GetPagedVertexId(MeshletsPagedCluster v, uint localV) { return m_pagePool[v.m_indirAt + localV]; }
+    float3 GetPagedPosition(MeshletsPagedCluster v, uint pageVertex)
+    {
+        const uint i = v.m_posAt + pageVertex * 3u;
+        return float3(asfloat(m_pagePool[i]), asfloat(m_pagePool[i + 1u]), asfloat(m_pagePool[i + 2u]));
+    }
+    float3 GetPagedNormal(MeshletsPagedCluster v, uint pageVertex)
+    {
+        const uint i = v.m_normAt + pageVertex * 3u;
+        return float3(asfloat(m_pagePool[i]), asfloat(m_pagePool[i + 1u]), asfloat(m_pagePool[i + 2u]));
+    }
+    float4 GetPagedTangent(MeshletsPagedCluster v, uint pageVertex)
+    {
+        const uint i = v.m_tanAt + pageVertex * 4u;
+        return float4(asfloat(m_pagePool[i]), asfloat(m_pagePool[i + 1u]),
+                      asfloat(m_pagePool[i + 2u]), asfloat(m_pagePool[i + 3u]));
+    }
+    float3 GetPagedBiTangent(MeshletsPagedCluster v, uint pageVertex)
+    {
+        const uint i = v.m_bitanAt + pageVertex * 3u;
+        return float3(asfloat(m_pagePool[i]), asfloat(m_pagePool[i + 1u]), asfloat(m_pagePool[i + 2u]));
+    }
+    float2 GetPagedUV(MeshletsPagedCluster v, uint pageVertex)
+    {
+        const uint i = v.m_uvAt + pageVertex * 2u;
+        return float2(asfloat(m_pagePool[i]), asfloat(m_pagePool[i + 1u]));
+    }
+
+    //! Stable vivid per-cluster color (matches the vertex-pull path's MeshletDebugColor).
+    float3 MeshletDebugColor(uint clusterId)
+    {
+        uint h = clusterId;
+        h ^= h >> 16; h *= 0x7feb352du; h ^= h >> 15; h *= 0x846ca68bu; h ^= h >> 16;
+        float3 c = float3(
+            ( h        & 0x3FFu) / 1023.0,
+            ((h >> 10) & 0x3FFu) / 1023.0,
+            ((h >> 20) & 0x3FFu) / 1023.0);
+        return 0.25 + 0.75 * c;
+    }
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsMotionVector.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsMotionVector.azsl
new file mode 100644
index 00000000000..ca1c833217b
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsMotionVector.azsl
@@ -0,0 +1,84 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// Meshlet motion-vector pass shader.
+//
+// PERF: hardware input-assembly. The VS reads a POSITION channel fetched through
+// the hardware index buffer (post-transform vertex-cache reuse), replacing
+// vertex-pull. The matching POSITION-only PSO input layout is built in
+// MeshletsFeatureProcessor (InitMotionShader). Renders per-pixel screen-space
+// motion for TAA / temporal upscaling via Atom's standard MeshMotionVector pass
+// (DrawListTag "motion"), exactly like a standard mesh — so the meshlet does not
+// ghost when the camera or the object moves.
+//
+// Math mirrors MeshMotionVector.azsli (the standard mesh path):
+//   motion = (currClip.xy/currClip.w - prevClip.xy/prevClip.w) * 0.5, Y flipped.
+// Jitter is already baked into the current/previous view-projection matrices, so
+// no explicit jitter handling is needed.
+
+#include <Atom/Features/SrgSemantics.azsli>
+#include <viewsrg_all.srgi>
+// Brings in scenesrg_all.srgi + MeshletsObjectRenderSrg (vertex buffers) +
+// MeshletsInstanceRenderSrg (m_objectId / GetWorldMatrix).
+#include <MeshletsPerObjectRenderSrg.azsli>
+
+struct VSInput
+{
+    float3 m_position : POSITION;
+    // Step B (hardware instancing): SV_InstanceID indexes m_instanceObjectIds on
+    // the cull-off path. 0 (and unused) on the non-instanced path.
+    uint m_instanceId : SV_InstanceID;
+};
+
+struct VSOutput
+{
+    float4 m_position     : SV_Position;
+    float3 m_worldPos     : TEXCOORD0;
+    float3 m_worldPosPrev : TEXCOORD1;
+};
+
+struct PSOutput
+{
+    float2 m_motion : SV_Target0;   //!< R16G16_FLOAT screen-space motion vector.
+};
+
+VSOutput MeshletsMotionVectorVS(VSInput IN)
+{
+    VSOutput OUT;
+
+    const float3 localPosition = IN.m_position;
+
+    // KEEP both current AND previous object-to-world transforms (prev drives the
+    // motion vector). Step B: hardware-instanced draws select objectId via
+    // SV_InstanceID (when m_useInstancing != 0), so EVERY instance gets its OWN
+    // prev transform — no ghosting; the non-instanced path keeps m_objectId.
+    const uint objectId = MeshletsInstanceRenderSrg::ResolveObjectId(IN.m_instanceId);
+    const float4x4 worldMatrix     = SceneSrg::GetObjectToWorldMatrix(objectId);
+    const float4x4 worldMatrixPrev = SceneSrg::GetObjectToWorldMatrixPrev(objectId);
+
+    OUT.m_worldPos     = mul(worldMatrix,     float4(localPosition, 1.0)).xyz;
+    OUT.m_worldPosPrev = mul(worldMatrixPrev, float4(localPosition, 1.0)).xyz;
+    OUT.m_position     = mul(ViewSrg::m_viewProjectionMatrix, float4(OUT.m_worldPos, 1.0));
+
+    return OUT;
+}
+
+PSOutput MeshletsMotionVectorPS(VSOutput IN)
+{
+    PSOutput OUT;
+
+    const float4 clipPos     = mul(ViewSrg::m_viewProjectionMatrix,     float4(IN.m_worldPos, 1.0));
+    const float4 clipPosPrev = mul(ViewSrg::m_viewProjectionPrevMatrix, float4(IN.m_worldPosPrev, 1.0));
+
+    float2 motion = (clipPos.xy / clipPos.w - clipPosPrev.xy / clipPosPrev.w) * 0.5;
+    // Flip Y to line up with UV coordinates (matches the standard mesh path).
+    motion.y = -motion.y;
+
+    OUT.m_motion = motion;
+    return OUT;
+}
