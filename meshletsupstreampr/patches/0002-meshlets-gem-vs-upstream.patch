+        MeshletPackWriter w;
+        w.BeginPack();
+        PackHeaderRecord h{};
+        h.m_meshCount = 0;
+        h.m_maxVerticesPerCluster = 64;
+        h.m_maxTrianglesPerCluster = 64;
+        h.m_coneWeight = 0.5f;
+        w.AddSection(SectionKind::PackHeader, &h, sizeof(h));
