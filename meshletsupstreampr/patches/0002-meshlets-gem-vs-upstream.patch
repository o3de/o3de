@@ -0,0 +1,44 @@
+{
+    "Source" : "./MeshletsDepthMeshShader.azsl",
+
+    // Two-pass occlusion, PASS 2 (opt-in r_meshletsTwoPassOcclusion): same AS +
+    // payload depth MS as MeshletsDepthMeshShaderCulled.shader, but tagged for the
+    // gem-injected MeshletsLateDepthPass, which runs AFTER this frame's HiZ pyramid
+    // is reduced. Its instance SRG runs the AS in visMode 2: only clusters pass 1
+    // skipped are tested (against THIS frame's pyramid) and the disoccluded
+    // survivors complete the depth buffer — removing the one-frame disocclusion pop
+    // and guaranteeing the pyramid is never built from a feedback-culled depth.
+    //
+    // Depth state matches the depth prepass exactly (reverse-Z, write on).
+    "DepthStencilState" :
+    {
+        "Depth" :
+        {
+            "Enable" : true,
+            "CompareFunc" : "GreaterEqual"
+        }
+    },
+
+    "ProgramSettings":
+    {
+      "EntryPoints":
+      [
+        {
+          "name": "MeshletsCullClustersAS",
+          "type": "Amplification"
+        },
+        {
+          "name": "MeshletsDepthPassMSCulled",
+          "type": "Mesh"
+        },
+        {
+          "name": "MeshletsDepthPassPS",
+          "type": "Fragment"
+        }
+      ]
+    },
+
+    // Gem-private tag: routed ONLY to MeshletsLateDepthPass (injected after
+    // GpuCullAndDrawPass), never to the standard early DepthPrePass.
+    "DrawList" : "meshletslatedepth"
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsDepthPass.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsDepthPass.azsl
new file mode 100644
index 00000000000..889e438c87d
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsDepthPass.azsl
@@ -0,0 +1,48 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// Meshlet depth-only pass shader.
+// PERF: hardware input-assembly. The vertex shader reads a POSITION channel that
+// the GPU fetches through the hardware index buffer (post-transform vertex cache
+// reuses shaded vertices). This replaces vertex-pull (3 scalar loads/vertex from a
+// StructuredBuffer with no cache) and is the main cost reduction for the depth
+// prepass. The matching PSO input layout is built in MeshletsFeatureProcessor
+// (InitDepthShader) and the per-mesh POSITION stream is bound via the geometry
+// view's StreamBufferView. No pixel shader — depth-only write.
+
+#include <Atom/Features/SrgSemantics.azsli>
+#include <viewsrg_all.srgi>
+#include <MeshletsPerObjectRenderSrg.azsli>
+
+struct VSInput
+{
+    float3 m_position : POSITION;
+    // Step B (hardware instancing): SV_InstanceID indexes m_instanceObjectIds on
+    // the cull-off path. 0 (and unused) on the non-instanced path.
+    uint m_instanceId : SV_InstanceID;
+};
+
+struct VSOutput
+{
+    precise float4 m_position : SV_Position;
+};
+
+VSOutput MeshletsDepthPassVS(VSInput IN)
+{
+    VSOutput OUT;
+
+    // Step B: hardware-instanced draws select objectId via SV_InstanceID (when
+    // m_useInstancing != 0); the non-instanced path keeps the per-draw m_objectId.
+    uint objectId = MeshletsInstanceRenderSrg::ResolveObjectId(IN.m_instanceId);
+    float4x4 world = SceneSrg::GetObjectToWorldMatrix(objectId);
+
+    float3 worldPosition = mul(world, float4(IN.m_position, 1.0)).xyz;
+    OUT.m_position = mul(ViewSrg::m_viewProjectionMatrix, float4(worldPosition, 1.0));
+
+    return OUT;
+}
