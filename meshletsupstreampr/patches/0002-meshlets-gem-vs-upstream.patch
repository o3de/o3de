+                AZ::AzCore
+                AZ::AzToolsFramework
+                AZ::AssetBuilderSDK
+                AZ::SceneCore
+                AZ::SceneData
+                Gem::${gem_name}.Reflect
+                Gem::Atom_RHI.Reflect
+                Gem::Atom_RPI.Public
+                3rdParty::meshoptimizer
