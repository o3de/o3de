+    {
+        if (m_triangleClusterCount == 0u)
+        {
+            return 0u;
+        }
+        uint tri = min(linearIndex / 3u, m_triangleClusterCount - 1u);
+        return m_triangleCluster[tri];
+    }
+
+    //! Debug: hash a cluster id to a stable, vivid color so adjacent meshlets are
+    //! easy to tell apart. Bias toward bright values so clusters read clearly
+    //! against the lit scene.
+    float3 MeshletDebugColor(uint clusterId)
+    {
+        uint h = clusterId;
+        h ^= h >> 16; h *= 0x7feb352du; h ^= h >> 15; h *= 0x846ca68bu; h ^= h >> 16;
+        float3 c = float3(
+            ( h        & 0x3FFu) / 1023.0,
+            ((h >> 10) & 0x3FFu) / 1023.0,
+            ((h >> 20) & 0x3FFu) / 1023.0);
+        return 0.25 + 0.75 * c;
+    }
+}
+
+// ----------------------------------------------------------------------------
+// Vertex-pull index fetch shared by every render shader's VS. Normally reads the
+// per-object static m_indices; when GPU cull's single-compacted-draw path is
+// active (m_useCompactedIndices != 0), reads the per-instance compacted stream
+// the cull compute produced. Centralised here so all 5 render shaders share one
+// gated read — the default (non-cull) path is byte-identical to before.
+// ----------------------------------------------------------------------------
+uint GetMeshVertexIndex(uint linearIndex)
+{
+    // ALL meshlet draws (whole-mesh, CPU cull, AND GPU per-cluster cull) are INDEXED over
+    // the mesh's expanded vertex-index stream — the IA already resolved corner -> mesh
+    // vertex, so SV_VertexID IS the mesh vertex index. Use it directly (no m_indices[]
+    // load); repeated indices hit the post-transform vertex cache (the whole point). GPU
+    // cull simply restricts WHICH index-buffer slices are drawn (visible clusters), via
+    // compacted DrawIndexedIndirect commands over this same buffer.
+    return linearIndex;
 }
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShader.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShader.azsl
new file mode 100644
index 00000000000..8c4121016f3
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShader.azsl
@@ -0,0 +1,168 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// Meshlet SHADOW pass — HARDWARE MESH SHADER path.
+//
+// The mesh-shader counterpart of MeshletsShadowPass.azsl (vertex-pull). Position
+// only, exactly like MeshletsDepthMeshShader.azsl; the only differences live in the
+// .shader descriptor (LessEqual depth test, depth bias, DrawList "shadow").
+//
+// WHY THIS MATTERS FOR PERF: shadows are usually the heaviest geometry cost in the
+// frame — every cascade rasterizes the whole visible set again. With only forward
+// and depth on DispatchMesh, a directional light with 4 cascades left 5 of ~7
+// geometry passes on the vertex-pull path, which is SLOWER than the standard mesh
+// path because it loses the post-transform vertex cache and re-transforms shared
+// vertices per index. Meshlets therefore could not win no matter how well the
+// forward pass performed. This pass is the biggest single piece of closing that.
+//
+// Atom rebinds ViewSrg::m_viewProjectionMatrix with the light's VP matrix per
+// cascade (see the comment in MeshletsShadowPass.azsl), so the transform here is
+// identical to the depth variant and needs no shadow-specific SRG.
+
+#include <Atom/Features/SrgSemantics.azsli>
+#include <viewsrg_all.srgi>
+// Pulls in scenesrg_all.srgi + MeshletsMeshObjectSrg/MeshletsMeshInstanceSrg.
+#include <MeshletsMeshRenderSrg.azsli>
+
+// Must match MeshletsForwardMeshShader.azsl / MeshletsDepthMeshShader.azsl —
+// clusters are baked at <=128 verts / <=256 tris, within the DX12 mesh-shader
+// per-group limits.
+#define MESHLETS_MS_MAX_VERTICES   128
+#define MESHLETS_MS_MAX_TRIANGLES  256
+#define MESHLETS_MS_THREADS        128
+
+struct VSOutput
+{
+    precise float4 m_position : SV_Position;
+};
+
+[outputtopology("triangle")]
+[numthreads(MESHLETS_MS_THREADS, 1, 1)]
+void MeshletsShadowPassMS(
+    uint groupThreadId : SV_GroupThreadID,
+    uint groupId       : SV_GroupID,
+    out vertices VSOutput outVerts[MESHLETS_MS_MAX_VERTICES],
+    out indices  uint3    outTris[MESHLETS_MS_MAX_TRIANGLES])
+{
+    // One threadgroup == one cluster. m_meshletsDescriptors is re-based per-mesh,
+    // so SV_GroupID indexes it directly. Decode mirrors MeshletsDepthPassMS exactly
+    // so the shadow map rasterizes the same triangles the depth prepass does.
+    const MeshletDescriptor cluster = MeshletsMeshObjectSrg::m_meshletsDescriptors[groupId];
+
+    const uint vertexCount   = min(cluster.m_vertexCount,   (uint)MESHLETS_MS_MAX_VERTICES);
+    const uint triangleCount = min(cluster.m_triangleCount, (uint)MESHLETS_MS_MAX_TRIANGLES);
+    SetMeshOutputCounts(vertexCount, triangleCount);
+
+    const uint objectId = MeshletsMeshInstanceSrg::m_objectId;
+    const float4x4 objectToWorld = SceneSrg::GetObjectToWorldMatrix(objectId);
+
+    // Position only — a shadow map writes depth and nothing else.
+    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
+    {
+        const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];
+
+        const float3 localPos = MeshletsMeshObjectSrg::GetPosition(meshVertex);
+        const float3 worldPos = mul(objectToWorld, float4(localPos, 1.0)).xyz;
+
+        VSOutput o;
+        // Rebound per cascade by the shadowmap pass — this is the light's VP.
+        o.m_position = mul(ViewSrg::m_viewProjectionMatrix, float4(worldPos, 1.0));
+        outVerts[v] = o;
+    }
+
+    // Unpacked 8-bit indices are cluster-LOCAL (0..vertexCount-1) and index the
+    // emitted vertex array directly.
+    for (uint t = groupThreadId; t < triangleCount; t += MESHLETS_MS_THREADS)
+    {
+        const uint encodedTri = MeshletsMeshObjectSrg::m_meshletsTriangles[cluster.m_triangleOffset + t];
+        outTris[t] = uint3(
+            (encodedTri      ) & 0xffu,
+            (encodedTri >>  8) & 0xffu,
+            (encodedTri >> 16) & 0xffu);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Phase 6 shadow-side DAG cut (MeshletsShadowMeshShaderCulled.shader): payload-
+// driven variant fed by the SHARED cluster-cull AS in "cut-only" mode — the
+// feature processor sets m_doFrustumCull/m_doConeCull/m_doHiZCull to 0 on the
+// shadow instance SRG (a light must rasterize clusters outside the CAMERA
+// frustum), leaving only the DAG cut. The shadow geometry therefore matches the
+// camera passes' cut exactly — no detail mismatch between depth and shadow.
+// ---------------------------------------------------------------------------
+#include <MeshletsCullAS.azsli>
+
+[outputtopology("triangle")]
+[numthreads(MESHLETS_MS_THREADS, 1, 1)]
+void MeshletsShadowPassMSCulled(
+    uint groupThreadId : SV_GroupThreadID,
+    uint groupId       : SV_GroupID,
+    in payload MeshletPayload payload,
+    out vertices VSOutput outVerts[MESHLETS_MS_MAX_VERTICES],
+    out indices  uint3    outTris[MESHLETS_MS_MAX_TRIANGLES])
+{
+    // The AS only ever writes valid (< clusterCount) ids and dispatches exactly
+    // survivorCount MS groups, so groupId indexes the payload directly.
+    const uint clusterId = payload.m_clusterIds[groupId];
+    const MeshletDescriptor cluster = MeshletsMeshObjectSrg::m_meshletsDescriptors[clusterId];
+
+    const uint vertexCount   = min(cluster.m_vertexCount,   (uint)MESHLETS_MS_MAX_VERTICES);
+    const uint triangleCount = min(cluster.m_triangleCount, (uint)MESHLETS_MS_MAX_TRIANGLES);
+    SetMeshOutputCounts(vertexCount, triangleCount);
+
+    const uint objectId = MeshletsMeshInstanceSrg::m_objectId;
+    const float4x4 objectToWorld = SceneSrg::GetObjectToWorldMatrix(objectId);
+
+    // Phase 7 streaming: paged (pool) fetch when active — see the forward variant.
+    const MeshletsPagedCluster pagedCluster =
+        (MeshletsMeshObjectSrg::m_pagedMode != 0u)
+            ? MeshletsMeshObjectSrg::GetPagedCluster(clusterId)
+            : (MeshletsPagedCluster)0;
+    const bool paged = pagedCluster.m_valid != 0u;
+
+    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
+    {
+        float3 localPos;
+        if (paged)
+        {
+            localPos = MeshletsMeshObjectSrg::GetPagedPosition(
+                pagedCluster, MeshletsMeshObjectSrg::GetPagedVertexId(pagedCluster, v));
+        }
+        else
+        {
+            const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];
+            localPos = MeshletsMeshObjectSrg::GetPosition(meshVertex);
+        }
+        const float3 worldPos = mul(objectToWorld, float4(localPos, 1.0)).xyz;
+
+        VSOutput o;
+        // Rebound per cascade by the shadowmap pass — this is the light's VP.
+        o.m_position = mul(ViewSrg::m_viewProjectionMatrix, float4(worldPos, 1.0));
+        outVerts[v] = o;
+    }
+
+    for (uint t = groupThreadId; t < triangleCount; t += MESHLETS_MS_THREADS)
+    {
+        const uint encodedTri = paged
+            ? MeshletsMeshObjectSrg::GetPagedTriangleWord(pagedCluster, t)
+            : MeshletsMeshObjectSrg::m_meshletsTriangles[cluster.m_triangleOffset + t];
+        outTris[t] = uint3(
+            (encodedTri      ) & 0xffu,
+            (encodedTri >>  8) & 0xffu,
+            (encodedTri >> 16) & 0xffu);
+    }
+}
+
+// Empty pixel shader — see the long note in MeshletsDepthMeshShader.azsl. Short
+// version: azslc counts entry functions from input-assembly reflection, a Mesh
+// entry contributes none, and a mesh-ONLY shader fails to build with "The number of
+// valid shader entry functions ... was 0!". An output-free PS keeps this a
+// depth-only draw and still permits early-Z.
+void MeshletsShadowPassPS(VSOutput IN)
+{
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShader.shader b/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShader.shader
new file mode 100644
index 00000000000..3876fffb3e5
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShader.shader
@@ -0,0 +1,45 @@
+{
+    "Source" : "./MeshletsShadowMeshShader.azsl",
+
+    // Mirrors MeshletsShadowPass.shader (the vertex-pull shadow pass) exactly:
+    // LessEqual depth test (shadow maps are NOT reverse-Z here) plus the same
+    // depth bias, so the mesh-shader path produces the same acne/peter-panning
+    // characteristics as the path it replaces.
+    "DepthStencilState" :
+    {
+        "Depth" :
+        {
+            "Enable" : true,
+            "CompareFunc" : "LessEqual"
+        }
+    },
+
+    "RasterState" :
+    {
+        "depthBias" : "10",
+        "depthBiasSlopeScale" : "4"
+    },
+
+    "ProgramSettings":
+    {
+      "EntryPoints":
+      [
+        {
+          "name": "MeshletsShadowPassMS",
+          "type": "Mesh"
+        },
+        {
+          "name": "MeshletsShadowPassPS",
+          "type": "Fragment"
+        }
+      ]
+    },
+
+    // The Fragment entry is an EMPTY pixel shader, present only to satisfy azslc's
+    // input-assembly reflection — see the comment on MeshletsShadowPassPS in the
+    // .azsl, and the longer version in MeshletsDepthMeshShader.azsl.
+
+    // Same tag as the vertex-pull MeshletsShadowPass.shader, so every shadowmap
+    // pass (cascades, projected) picks this DrawItem up with no .pass changes.
+    "DrawList" : "shadow"
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShaderCulled.shader b/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShaderCulled.shader
new file mode 100644
index 00000000000..33bc13f2984
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsShadowMeshShaderCulled.shader
@@ -0,0 +1,51 @@
+{
+    "Source" : "./MeshletsShadowMeshShader.azsl",
+
+    // Phase 6 shadow-side DAG cut. Pairs the SHARED cluster-cull AS
+    // (MeshletsCullAS.azsli) with the payload-driven MeshletsShadowPassMSCulled
+    // entry. The AS runs in "cut-only" mode for shadows: the feature processor
+    // zeroes m_doFrustumCull/m_doConeCull/m_doHiZCull on the shadow instance SRG
+    // (a light must rasterize clusters outside the CAMERA frustum), so the only
+    // rejection is the main-view DAG cut — shadow geometry matches the shaded cut
+    // exactly. Split from MeshletsShadowMeshShader.shader for the same reason as
+    // every other culled pair: the shipped no-cull PSO keeps plain DispatchMesh
+    // semantics.
+    //
+    // Render state mirrors MeshletsShadowMeshShader.shader exactly (LessEqual +
+    // depth bias — shadow maps are NOT reverse-Z here).
+    "DepthStencilState" :
+    {
+        "Depth" :
+        {
+            "Enable" : true,
+            "CompareFunc" : "LessEqual"
+        }
+    },
+
+    "RasterState" :
+    {
+        "depthBias" : "10",
+        "depthBiasSlopeScale" : "4"
+    },
+
+    "ProgramSettings":
+    {
+      "EntryPoints":
+      [
+        {
+          "name": "MeshletsCullClustersAS",
+          "type": "Amplification"
+        },
+        {
+          "name": "MeshletsShadowPassMSCulled",
+          "type": "Mesh"
+        },
+        {
+          "name": "MeshletsShadowPassPS",
+          "type": "Fragment"
+        }
+      ]
+    },
+
+    "DrawList" : "shadow"
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsShadowPass.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsShadowPass.azsl
new file mode 100644
index 00000000000..9a31d9cb8e3
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsShadowPass.azsl
@@ -0,0 +1,48 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// Meshlet shadow pass shader.
+// PERF: hardware input-assembly. The VS reads a POSITION channel fetched by the
+// GPU through the hardware index buffer (post-transform vertex-cache reuse),
+// replacing vertex-pull. The matching POSITION-only PSO input layout is built in
+// MeshletsFeatureProcessor (InitShadowShader); the per-mesh POSITION stream is
+// bound via the geometry view's StreamBufferView. The shadow system provides
+// ViewSrg::m_viewProjectionMatrix with the light's VP matrix per cascade.
+// No pixel shader — depth-only write into the shadowmap.
+
+#include <Atom/Features/SrgSemantics.azsli>
+#include <viewsrg_all.srgi>
+#include <MeshletsPerObjectRenderSrg.azsli>
+
+struct VSInput
+{
+    float3 m_position : POSITION;
+    // Step B (hardware instancing): SV_InstanceID indexes m_instanceObjectIds on
+    // the cull-off path. 0 (and unused) on the non-instanced path.
+    uint m_instanceId : SV_InstanceID;
+};
+
+struct VSOutput
+{
+    float4 m_position : SV_Position;
+};
+
+VSOutput MeshletsShadowPassVS(VSInput IN)
+{
+    VSOutput OUT;
+
+    // Step B: hardware-instanced draws select objectId via SV_InstanceID (when
+    // m_useInstancing != 0); the non-instanced path keeps the per-draw m_objectId.
+    uint objectId = MeshletsInstanceRenderSrg::ResolveObjectId(IN.m_instanceId);
+    float4x4 world = SceneSrg::GetObjectToWorldMatrix(objectId);
+
+    float3 worldPosition = mul(world, float4(IN.m_position, 1.0)).xyz;
+    OUT.m_position = mul(ViewSrg::m_viewProjectionMatrix, float4(worldPosition, 1.0));
+
+    return OUT;
+}
