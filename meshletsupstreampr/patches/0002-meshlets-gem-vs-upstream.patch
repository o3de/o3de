diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsPageUpload.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsPageUpload.azsl
new file mode 100644
index 00000000000..204b4318443
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsPageUpload.azsl
@@ -0,0 +1,51 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// Phase 7 streaming, PASS-agnostic page upload (design §2's "double-buffered upload"):
+// copies one page payload from a freshly-created STAGING buffer (the ReadOnly-pool
+// initial-data path — the only CPU->GPU upload path proven on this AMD GPU) into its
+// reserved slot of the global page pool, prefixed by the 4-word slot header. Runs as
+// a dispatch on the meshlets cull compute pass (before DepthPrePass), with the pool
+// imported ReadWrite there and transitioned to shader-read by the barrier pass —
+// exactly the machinery the cull args already use.
+
+#include <Atom/Features/SrgSemantics.azsli>
+
+ShaderResourceGroup MeshletsPageUploadSrg : SRG_PerObject
+{
+    //! Staging copy of the page payload, viewed as u32 words.
+    StructuredBuffer<uint> m_src;
+    //! The global page pool. Bound to the frame graph's scope-backed view and
+    //! compiled inside the compute pass's CompileResources (finalize mechanism).
+    RWStructuredBuffer<uint> m_dstPool;
+    uint m_dstSlotBase;    //!< slot * PageSlotU32s.
+    uint m_payloadU32s;    //!< Payload words (after the header).
+    uint4 m_header;        //!< {clusterCount, vertexCount, triangleWords, indirCount}.
+};
+
+//! One thread per destination word: [0,4) = header, [4, 4+payload) = payload copy.
+[numthreads(64, 1, 1)]
+void UploadPage(uint3 dispatchThreadId : SV_DispatchThreadID)
+{
+    const uint i = dispatchThreadId.x;
+    const uint total = 4u + MeshletsPageUploadSrg::m_payloadU32s;
+    if (i >= total)
+    {
+        return;
+    }
+    if (i < 4u)
+    {
+        MeshletsPageUploadSrg::m_dstPool[MeshletsPageUploadSrg::m_dstSlotBase + i] =
+            MeshletsPageUploadSrg::m_header[i];
+    }
+    else
+    {
+        MeshletsPageUploadSrg::m_dstPool[MeshletsPageUploadSrg::m_dstSlotBase + i] =
+            MeshletsPageUploadSrg::m_src[i - 4u];
+    }
+}
