diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsClusterCullMath.azsli b/Gems/Meshlets/Assets/Shaders/MeshletsClusterCullMath.azsli
new file mode 100644
index 00000000000..56d2f1e8e32
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsClusterCullMath.azsli
@@ -0,0 +1,206 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+#pragma once
+
+// Pure, SRG-independent per-cluster cull math (frustum + cone + HiZ-occlusion).
+// Shared between the compute GPU-cull path (MeshletsCull.azsl, per-instance
+// indirect-draw compaction) and the amplification-shader cull path
+// (MeshletsForwardMeshShader.azsl's MeshletsCullClustersAS, Phase 5). Every
+// function takes its inputs explicitly (no SRG reads) so each caller composes
+// them against its own bound resources. Compute/mesh/amplification-safe: no
+// ddx/ddy, no implicit-LOD Sample (Texture2D::Load + explicit mip only).
+
+//! Mirrors AZ::Meshlets::ClusterBoundsRecord (48 bytes = 3x float4).
+struct ClusterBoundsRecord
+{
+    float4 m_centerRadius;   // xyz = center, w = radius
+    float4 m_apexCutoff;     // xyz = coneApex, w = coneCutoff (>=1 => no cone)
+    float4 m_axisPad;        // xyz = coneAxis
+};
+
+float3 MeshletsTransformPoint(float4 worldRow0, float4 worldRow1, float4 worldRow2, float3 p)
+{
+    return float3(
+        dot(worldRow0.xyz, p) + worldRow0.w,
+        dot(worldRow1.xyz, p) + worldRow1.w,
+        dot(worldRow2.xyz, p) + worldRow2.w);
+}
+
+float3 MeshletsTransformDir(float4 worldRow0, float4 worldRow1, float4 worldRow2, float3 d)
+{
+    return float3(
+        dot(worldRow0.xyz, d),
+        dot(worldRow1.xyz, d),
+        dot(worldRow2.xyz, d));
+}
+
+float MeshletsMaxAxisScale(float4 worldRow0, float4 worldRow1, float4 worldRow2)
+{
+    const float sx = length(float3(worldRow0.x, worldRow1.x, worldRow2.x));
+    const float sy = length(float3(worldRow0.y, worldRow1.y, worldRow2.y));
+    const float sz = length(float3(worldRow0.z, worldRow1.z, worldRow2.z));
+    return max(sx, max(sy, sz));
+}
+
+//! True if the world-space bounding sphere (centerW,radiusW) is NOT rejected by any
+//! of the 6 world-space frustum planes (xyz=inward normal, w=d; inside => dot(n,p)+d >= 0).
+bool MeshletsFrustumTestSphere(float3 centerW, float radiusW, float4 frustumPlanes[6])
+{
+    [unroll] for (uint p = 0; p < 6; ++p)
+    {
+        const float4 plane = frustumPlanes[p];
+        if (dot(plane.xyz, centerW) + plane.w < -radiusW)
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+//! True if the cluster's backface cone entirely faces away from the camera (i.e. it
+//! should be CULLED). coneCutoff >= 1.0 disables the test (never culls).
+bool MeshletsConeCulled(float3 apexW, float3 axisW, float coneCutoff, float3 cameraPosW)
+{
+    if (coneCutoff >= 1.0)
+    {
+        return false;
+    }
+    float3 toApex = apexW - cameraPosW;
+    const float axisLen = length(axisW);
+    const float toApexLen = length(toApex);
+    if (axisLen <= 1e-6 || toApexLen <= 1e-6)
+    {
+        return false;
+    }
+    axisW /= axisLen;
+    toApex /= toApexLen;
+    return dot(toApex, axisW) >= coneCutoff;
+}
+
+// Project a world-space bounding sphere to an NDC-derived screen-space AABB in
+// [0,1] UV coordinates.
+float4 MeshletsProjectSphereToNdcAabb(float3 centerW, float radiusW, row_major float4x4 worldToClip)
+{
+    float4 clipCenter = mul(worldToClip, float4(centerW, 1.0));
+    if (clipCenter.w <= 0.0)
+    {
+        // Behind the camera -- return a full-screen AABB (conservative: never occludes).
+        return float4(0, 0, 1, 1);
+    }
+    float3 ndc = clipCenter.xyz / clipCenter.w;
+    float dist = clipCenter.w;
+    float2 screenRadiusUV = float2(
+        (radiusW / dist) * abs(worldToClip[0][0]) * 0.5,
+        (radiusW / dist) * abs(worldToClip[1][1]) * 0.5);
+    float2 uvCenter = ndc.xy * float2(0.5, -0.5) + 0.5;
+    float2 uvMin = saturate(uvCenter - screenRadiusUV);
+    float2 uvMax = saturate(uvCenter + screenRadiusUV);
+    return float4(uvMin, uvMax);
+}
+
+// Minimum (farthest, reverse-Z) depth under an NDC AABB, sampled at the mip whose
+// texel size roughly matches the AABB's screen extent. Load-based (no ddx/ddy /
+// implicit-LOD Sample) -- required outside pixel shaders.
+float MeshletsSampleHiZMin(float4 ndcAabb, Texture2D<float> hiZTexture)
+{
+    uint hiZWidth, hiZHeight, hiZMipCount;
+    hiZTexture.GetDimensions(0, hiZWidth, hiZHeight, hiZMipCount);
+
+    float2 aabbSize = (ndcAabb.zw - ndcAabb.xy) * float2(hiZWidth, hiZHeight);
+    float maxExtent = max(max(aabbSize.x, aabbSize.y), 1.0);
+    // MUST round UP (ceil): pick the coarsest mip whose texel footprint still fully
+    // contains the AABB (2^mip >= maxExtent), or the 4 corner taps below can miss an
+    // interior texel and wrongly report "occluded" for visible geometry.
+    float mipLevel = clamp(ceil(log2(maxExtent)), 0.0, float(hiZMipCount - 1));
+    uint mip = uint(mipLevel);
+
+    uint mipWidth  = max(1u, hiZWidth  >> mip);
+    uint mipHeight = max(1u, hiZHeight >> mip);
+
+    uint2 minTexel = min(uint2(ndcAabb.xy * float2(mipWidth, mipHeight)), uint2(mipWidth - 1, mipHeight - 1));
+    uint2 maxTexel = min(uint2(ndcAabb.zw * float2(mipWidth, mipHeight)), uint2(mipWidth - 1, mipHeight - 1));
+
+    float d0 = hiZTexture.Load(int3(minTexel.x, minTexel.y, mip));
+    float d1 = hiZTexture.Load(int3(maxTexel.x, minTexel.y, mip));
+    float d2 = hiZTexture.Load(int3(minTexel.x, maxTexel.y, mip));
+    float d3 = hiZTexture.Load(int3(maxTexel.x, maxTexel.y, mip));
+    return min(min(d0, d1), min(d2, d3));
+}
+
+// ---------------------------------------------------------------------------
+// Phase 6 cluster-DAG continuous LOD (pure math; both cull paths compose it).
+// ---------------------------------------------------------------------------
+
+//! Mirrors AZ::Meshlets::DagNodeRecord (48 bytes = 3x float4).
+struct MeshletDagNodeRecord
+{
+    float4 m_selfSphere;     //!< xyz = center (object space), w = radius
+    float4 m_parentSphere;
+    float4 m_errors;         //!< x = selfError, y = parentError (object units), zw = pad
+};
+
+//! Projected screen-space error, in pixels, of an object-space (sphere, error)
+//! pair already transformed to world space. projScale = cot(FovY/2) *
+//! viewportHeight * 0.5 (pure projection — rotation-independent, the same
+//! yScale lesson as the coverage LOD ladder). Camera inside the sphere returns
+//! +inf: forces refinement toward children — conservative and stable.
+float MeshletsDagProjectedErrorPx(float3 centerW, float radiusW, float errW, float3 cameraPosW, float projScale)
+{
+    const float dist = length(centerW - cameraPosW) - radiusW;
+    if (dist <= 1e-4)
+    {
+        return 3.402823e38;   // effectively +inf
+    }
+    return (errW * projScale) / dist;
+}
+
+//! x = the node's own (group) projected error in pixels, y = its parent group's.
+float2 MeshletsDagNodeErrorsPx(
+    MeshletDagNodeRecord node,
+    float4 worldRow0, float4 worldRow1, float4 worldRow2,
+    float3 cameraPosW, float projScale)
+{
+    const float maxScale = MeshletsMaxAxisScale(worldRow0, worldRow1, worldRow2);
+    const float selfErrPx = MeshletsDagProjectedErrorPx(
+        MeshletsTransformPoint(worldRow0, worldRow1, worldRow2, node.m_selfSphere.xyz),
+        node.m_selfSphere.w * maxScale, node.m_errors.x * maxScale, cameraPosW, projScale);
+    const float parentErrPx = MeshletsDagProjectedErrorPx(
+        MeshletsTransformPoint(worldRow0, worldRow1, worldRow2, node.m_parentSphere.xyz),
+        node.m_parentSphere.w * maxScale, node.m_errors.y * maxScale, cameraPosW, projScale);
+    return float2(selfErrPx, parentErrPx);
+}
+
+//! True if the DAG cut selects this cluster: its own (group) error is acceptable
+//! on screen AND its parent group's is not. The builder's invariants (monotonic
+//! max()-propagated errors, group-shared records, parent spheres enclosing self
+//! spheres) guarantee exactly one level per DAG path passes — a complete,
+//! crack-free cut with no traversal. Leaves have selfError 0 (always eligible);
+//! roots have parentError FLT_MAX (never rejected as "parent good enough").
+bool MeshletsDagCutAccepts(
+    MeshletDagNodeRecord node,
+    float4 worldRow0, float4 worldRow1, float4 worldRow2,
+    float3 cameraPosW, float projScale, float tauPx)
+{
+    const float2 errs = MeshletsDagNodeErrorsPx(node, worldRow0, worldRow1, worldRow2, cameraPosW, projScale);
+    return errs.x <= tauPx && errs.y > tauPx;
+}
+
+// Reverse-Z depth (near=1, far=0) of the point on the sphere closest to the camera.
+float MeshletsComputeClosestClusterDepth(float3 centerW, float radiusW, float3 cameraPosW, row_major float4x4 worldToClip)
+{
+    float3 toCam = cameraPosW - centerW;
+    float distToCam = length(toCam);
+    float3 closestPoint = (distToCam > 1e-6) ? (centerW + (toCam / distToCam) * radiusW) : centerW;
+    float4 clipPos = mul(worldToClip, float4(closestPoint, 1.0));
+    if (clipPos.w <= 0.0)
+    {
+        return 1.0;   // in front of the near plane (reverse-Z near=1) -- definitely not occluded
+    }
+    return saturate(clipPos.z / clipPos.w);
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsCull.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsCull.azsl
new file mode 100644
index 00000000000..3f25a0e0081
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsCull.azsl
@@ -0,0 +1,225 @@
+/*
+ * Copyright (c) Contributors to the Open 3D Engine Project.
+ * For complete copyright and license terms please see the LICENSE at the root of this distribution.
+ *
+ * SPDX-License-Identifier: Apache-2.0 OR MIT
+ *
+ */
+
+// GPU per-cluster (surfel) cull → compacted indirect DRAW COMMANDS (Phase 6, GPU path).
+//
+// ONE thread-group per instance. The group frustum + backface-cone culls every
+// cluster (same math as the CPU MeshletsRenderObject::CullClustersToCommands) and,
+// for each VISIBLE cluster, atomically appends a DrawIndexedIndirect command
+//   { indexCount = triCount*3, instanceCount = 1, startIndex = triOffset*3, baseVertex = 0, startInstance = 0 }
+// into m_outCommands, then thread 0 writes the visible-command count to m_outCount.
+//
+// The render passes then issue ONE DrawIndexedIndirectCount over the mesh's STATIC
+// index buffer (the real expanded vertex-index stream — the same buffer the whole-mesh
+// draw uses). Each command renders that cluster's slice of the index buffer, so:
+//   * only visible clusters are drawn (surfel culling), AND
+//   * the post-transform vertex cache reuses shaded vertices within each cluster
+//     (the slice indexes real mesh vertices) — the win the previous "compact the index
+//     stream" approach forfeited (it was non-indexed, every corner a unique SV_VertexID).
+// Because the index buffer is static (never GPU-written), there is no UAV->SRV index
+// barrier to get wrong; only the small command + count buffers transition UAV->Indirect.
+
+#pragma once
+
+#include <Atom/Features/SrgSemantics.azsli>
+
+// Per-cluster cull math (frustum/cone/HiZ) + the ClusterBoundsRecord struct are
+// shared with the amplification-shader cull path -- see MeshletsClusterCullMath.azsli.
+#include <MeshletsClusterCullMath.azsli>
+
+// MUST equal MeshletsDispatchItem's MESHLETS_THREAD_GROUP_SIZE (one group per instance).
+#define MESHLETS_CULL_GROUP 64
+
+//! Mirrors AZ::Meshlets::ClusterDescriptor (16 bytes = uint4).
+struct ClusterDescriptor
+{
+    uint4 m_data;            // x=vertexOffset, y=triangleOffset, z=vertexCount, w=triangleCount
+};
+
+//! Mirrors the gem's DrawIndexedIndirectCommand (20 bytes = 5x u32).
+struct DrawIndexedIndirectCommand
+{
+    uint m_indexCount;
+    uint m_instanceCount;
+    uint m_startIndex;
+    uint m_baseVertex;
+    uint m_startInstance;
+};
+
+ShaderResourceGroup MeshletsCullSrg : SRG_PerObject
+{
+    // Per-mesh inputs (read only).
+    StructuredBuffer<ClusterBoundsRecord> m_clusterBounds;
+    StructuredBuffer<ClusterDescriptor>   m_clusterDescriptors;
+
+    // Per-cluster HiZ occlusion (shares the reverse-Z pyramid the RPI HiZGeneratePass
+    // already produces for the standard-mesh GPU-driven path -- no second pyramid).
+    // Left unbound (default/null resource) until a pipeline wires it; GetDimensions
+    // then reads 0x0 and ClusterVisible's dimension check safely skips occlusion, same
+    // "optional -- no occlusion test if unbound" contract as Atom's own GpuFrustumCull.azsl.
+    Texture2D<float> m_hiZTexture;
+
+    // Per-instance outputs (written as UAV here; consumed as indirect args later).
+    //! Compacted per-cluster DrawIndexedIndirect commands (visible clusters only).
+    RWStructuredBuffer<DrawIndexedIndirectCommand> m_outCommands;
+    //! m_outCount[0] = number of visible commands == the indirect draw's count.
+    RWStructuredBuffer<uint> m_outCount;
+
+    // Per-instance cull parameters (object->world as 3 explicit rows — major-ness safe).
+    float4 m_worldRow0;
+    float4 m_worldRow1;
+    float4 m_worldRow2;
+    float4 m_frustumPlanes[6];   // world-space, xyz=inward normal, w=d; inside => dot(n,p)+d >= 0
+    float4 m_cameraPosition;     // xyz = camera world position
+    // World->clip of the cull camera (live or frozen; same one m_frustumPlanes was
+    // derived from on the CPU), used only to project cluster bounds for the HiZ test.
+    row_major float4x4 m_worldToClip;
+    uint   m_clusterCount;
+    uint   m_doFrustumCull;      // 0/1
+    uint   m_doConeCull;         // 0/1
+    uint   m_doHiZCull;          // 0/1 -- opt-in; also gated by m_hiZTexture actually being bound
+
+    // ---- Phase 6 cluster-DAG cut (opt-in r_meshletsDagLod) ----
+    // C++ invariant (UpdateGpuCullInstance): m_clusterCount spans the FULL
+    // leaf+interior DAG range ONLY while m_doDagCut == 1; otherwise it is clamped
+    // to the leaf count, so interiors can never draw with the cut off.
+    uint   m_doDagCut;           // 0/1
+    float  m_dagProjScale;       // cot(FovY/2) * viewportHeight * 0.5
+    float  m_dagErrorPx;         // cut threshold in pixels
+
+    //! Per-cluster DAG cut records, parallel to m_clusterDescriptors (leaf-first).
+    //! Unbound for v2 packs -- m_doDagCut is then always 0.
+    StructuredBuffer<MeshletDagNodeRecord> m_dagNodes;
+};
+
+//! True if cluster \p clusterId survives frustum + cone + HiZ-occlusion culling
+//! (matches the CPU path for frustum/cone; HiZ occlusion is GPU-only). Thin SRG-bound
+//! wrapper over the pure functions in MeshletsClusterCullMath.azsli -- behavior is
+//! unchanged from before the refactor, just de-duplicated (the amplification-shader
+//! cull path, MeshletsForwardMeshShader.azsl, composes the SAME functions against its
+//! own bound resources).
+bool ClusterVisible(uint clusterId)
+{
+    // Phase 6 cluster-DAG cut — before the passthrough early-out, same ordering
+    // (and same shared math) as the AS path's MeshletClusterVisible so the two
+    // stay correctness oracles for each other.
+    if (MeshletsCullSrg::m_doDagCut != 0u)
+    {
+        if (!MeshletsDagCutAccepts(
+                MeshletsCullSrg::m_dagNodes[clusterId],
+                MeshletsCullSrg::m_worldRow0, MeshletsCullSrg::m_worldRow1, MeshletsCullSrg::m_worldRow2,
+                MeshletsCullSrg::m_cameraPosition.xyz,
+                MeshletsCullSrg::m_dagProjScale, MeshletsCullSrg::m_dagErrorPx))
+        {
+            return false;
+        }
+    }
+
+    if (MeshletsCullSrg::m_doFrustumCull == 0u && MeshletsCullSrg::m_doConeCull == 0u &&
+        MeshletsCullSrg::m_doHiZCull == 0u)
+    {
+        return true;   // passthrough
+    }
+
+    const ClusterBoundsRecord b = MeshletsCullSrg::m_clusterBounds[clusterId];
+    const float maxScale = MeshletsMaxAxisScale(
+        MeshletsCullSrg::m_worldRow0, MeshletsCullSrg::m_worldRow1, MeshletsCullSrg::m_worldRow2);
+    const float3 centerW = MeshletsTransformPoint(
+        MeshletsCullSrg::m_worldRow0, MeshletsCullSrg::m_worldRow1, MeshletsCullSrg::m_worldRow2,
+        b.m_centerRadius.xyz);
+    const float  radiusW = b.m_centerRadius.w * maxScale;
+    bool visible = true;
+
+    if (MeshletsCullSrg::m_doFrustumCull != 0u &&
+        !MeshletsFrustumTestSphere(centerW, radiusW, MeshletsCullSrg::m_frustumPlanes))
+    {
+        visible = false;
+    }
+
+    // --- Per-cluster HiZ occlusion (shared pyramid; conservative when uncertain) ---
+    // Gated on the texture actually being bound (GetDimensions returns 0x0 for the
+    // default/null resource when no pipeline has wired m_hiZTexture yet) so this is a
+    // safe no-op until a HiZ pyramid Connection exists -- never culls on a guess.
+    if (visible && MeshletsCullSrg::m_doHiZCull != 0u)
+    {
+        uint hiZW, hiZH;
+        MeshletsCullSrg::m_hiZTexture.GetDimensions(hiZW, hiZH);
+        if (hiZW > 0 && hiZH > 0)
+        {
+            float4 ndcAabb = MeshletsProjectSphereToNdcAabb(centerW, radiusW, MeshletsCullSrg::m_worldToClip);
+            float hiZDepth = MeshletsSampleHiZMin(ndcAabb, MeshletsCullSrg::m_hiZTexture);
+            float closestDepth = MeshletsComputeClosestClusterDepth(
+                centerW, radiusW, MeshletsCullSrg::m_cameraPosition.xyz, MeshletsCullSrg::m_worldToClip);
+            if (closestDepth < hiZDepth)
+            {
+                visible = false;
+            }
+        }
+    }
+
+    const float coneCutoff = b.m_apexCutoff.w;
+    if (visible && MeshletsCullSrg::m_doConeCull != 0u && coneCutoff < 1.0)
+    {
+        const float3 apexW = MeshletsTransformPoint(
+            MeshletsCullSrg::m_worldRow0, MeshletsCullSrg::m_worldRow1, MeshletsCullSrg::m_worldRow2,
+            b.m_apexCutoff.xyz);
+        const float3 axisW = MeshletsTransformDir(
+            MeshletsCullSrg::m_worldRow0, MeshletsCullSrg::m_worldRow1, MeshletsCullSrg::m_worldRow2,
+            b.m_axisPad.xyz);
+        if (MeshletsConeCulled(apexW, axisW, coneCutoff, MeshletsCullSrg::m_cameraPosition.xyz))
+        {
+            visible = false;
+        }
+    }
+    return visible;
+}
+
+//! Group-wide visible-command counter (the append slot + the final draw count).
+groupshared uint g_commandCount;
+
+[numthreads(MESHLETS_CULL_GROUP, 1, 1)]
+void CullClusters(uint3 groupThreadId : SV_GroupThreadID)
+{
+    const uint lane = groupThreadId.x;
+
+    if (lane == 0)
+    {
+        g_commandCount = 0;
+    }
+    GroupMemoryBarrierWithGroupSync();
+
+    // Each lane strides over clusters; visible clusters append one DrawIndexedIndirect
+    // command at an atomically-reserved slot.
+    for (uint c = lane; c < MeshletsCullSrg::m_clusterCount; c += MESHLETS_CULL_GROUP)
+    {
+        if (!ClusterVisible(c))
+        {
+            continue;
+        }
+        const ClusterDescriptor cd = MeshletsCullSrg::m_clusterDescriptors[c];
+
+        uint slot;
+        InterlockedAdd(g_commandCount, 1u, slot);
+
+        DrawIndexedIndirectCommand cmd;
+        cmd.m_indexCount    = cd.m_data.w * 3u;   // triangleCount * 3
+        cmd.m_instanceCount = 1u;
+        cmd.m_startIndex    = cd.m_data.y * 3u;   // triangleOffset * 3 (slice of the static index buffer)
+        cmd.m_baseVertex    = 0u;
+        cmd.m_startInstance = 0u;
+        MeshletsCullSrg::m_outCommands[slot] = cmd;
+    }
+
+    GroupMemoryBarrierWithGroupSync();
+
+    // Thread 0 publishes the visible-command count for DrawIndexedIndirectCount.
+    if (lane == 0)
+    {
+        MeshletsCullSrg::m_outCount[0] = g_commandCount;
+    }
+}
