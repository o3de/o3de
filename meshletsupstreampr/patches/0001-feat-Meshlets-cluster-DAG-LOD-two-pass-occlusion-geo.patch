diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShader.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShader.azsl
index 7fb320795ac..42482083a4a 100644
--- a/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShader.azsl
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShader.azsl
@@ -81,6 +81,77 @@ void MeshletsDepthPassMS(
     }
 }
 
+// ---------------------------------------------------------------------------
+// AS-culled variant (opt-in r_meshletsMsCullAS, MeshletsDepthMeshShaderCulled.shader):
+// same emit as MeshletsDepthPassMS but driven by the shared cluster-cull AS's
+// payload, so the depth prepass dispatches the same AS group counts as the culled
+// forward PSO (a DrawPacket binds ONE geometry view for all its items). No
+// per-triangle cull here — emitting all triangles of surviving clusters keeps
+// depth coverage a superset of the forward pass's (conservative; forward tests
+// GreaterEqual, not Equal, so extra depth triangles are harmless).
+// ---------------------------------------------------------------------------
+#include <MeshletsCullAS.azsli>
+
+[outputtopology("triangle")]
+[numthreads(MESHLETS_MS_THREADS, 1, 1)]
+void MeshletsDepthPassMSCulled(
+    uint groupThreadId : SV_GroupThreadID,
+    uint groupId       : SV_GroupID,
+    in payload MeshletPayload payload,
+    out vertices VSOutput outVerts[MESHLETS_MS_MAX_VERTICES],
+    out indices  uint3    outTris[MESHLETS_MS_MAX_TRIANGLES])
+{
+    // The AS only ever writes valid (< clusterCount) ids and dispatches exactly
+    // survivorCount MS groups, so groupId indexes the payload directly.
+    const uint clusterId = payload.m_clusterIds[groupId];
+    const MeshletDescriptor cluster = MeshletsMeshObjectSrg::m_meshletsDescriptors[clusterId];
+
+    const uint vertexCount   = min(cluster.m_vertexCount,   (uint)MESHLETS_MS_MAX_VERTICES);
+    const uint triangleCount = min(cluster.m_triangleCount, (uint)MESHLETS_MS_MAX_TRIANGLES);
+    SetMeshOutputCounts(vertexCount, triangleCount);
+
+    const uint objectId = MeshletsMeshInstanceSrg::m_objectId;
+    const float4x4 objectToWorld = SceneSrg::GetObjectToWorldMatrix(objectId);
+
+    // Phase 7 streaming: paged (pool) fetch when active — see the forward variant.
+    const MeshletsPagedCluster pagedCluster =
+        (MeshletsMeshObjectSrg::m_pagedMode != 0u)
+            ? MeshletsMeshObjectSrg::GetPagedCluster(clusterId)
+            : (MeshletsPagedCluster)0;
+    const bool paged = pagedCluster.m_valid != 0u;
+
+    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
+    {
+        float3 localPos;
+        if (paged)
+        {
+            localPos = MeshletsMeshObjectSrg::GetPagedPosition(
+                pagedCluster, MeshletsMeshObjectSrg::GetPagedVertexId(pagedCluster, v));
+        }
+        else
+        {
+            const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];
+            localPos = MeshletsMeshObjectSrg::GetPosition(meshVertex);
+        }
+        const float3 worldPos = mul(objectToWorld, float4(localPos, 1.0)).xyz;
+
+        VSOutput o;
+        o.m_position = mul(ViewSrg::m_viewProjectionMatrix, float4(worldPos, 1.0));
+        outVerts[v] = o;
+    }
+
+    for (uint t = groupThreadId; t < triangleCount; t += MESHLETS_MS_THREADS)
+    {
+        const uint encodedTri = paged
+            ? MeshletsMeshObjectSrg::GetPagedTriangleWord(pagedCluster, t)
+            : MeshletsMeshObjectSrg::m_meshletsTriangles[cluster.m_triangleOffset + t];
+        outTris[t] = uint3(
+            (encodedTri      ) & 0xffu,
+            (encodedTri >>  8) & 0xffu,
+            (encodedTri >> 16) & 0xffu);
+    }
+}
+
 // Empty pixel shader — writes nothing, so this stays a depth-only draw (the depth
 // pass binds no render targets, and an output-free PS still permits early-Z).
 //
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShaderCulled.shader b/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShaderCulled.shader
new file mode 100644
index 00000000000..fff155c9da5
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShaderCulled.shader
@@ -0,0 +1,43 @@
+{
+    "Source" : "./MeshletsDepthMeshShader.azsl",
+
+    // AS-culled depth prepass PSO (opt-in r_meshletsMsCullAS). SEPARATE .shader from
+    // MeshletsDepthMeshShader.shader for the same reason the forward pair is split:
+    // adding an Amplification stage to the default depth PSO would change the shipped
+    // no-cull path's dispatch semantics. This PSO pairs the SHARED cluster-cull AS
+    // (MeshletsCullAS.azsli — the same entry the culled forward PSO uses, so depth
+    // and forward can never disagree on surviving clusters) with the payload-driven
+    // MeshletsDepthPassMSCulled entry.
+    //
+    // Render state mirrors MeshletsDepthMeshShader.shader exactly (reverse-Z, depth
+    // write on, no stencil).
+    "DepthStencilState" :
+    {
+        "Depth" :
+        {
+            "Enable" : true,
+            "CompareFunc" : "GreaterEqual"
+        }
+    },
+
+    "ProgramSettings":
+    {
+      "EntryPoints":
+      [
+        {
+          "name": "MeshletsCullClustersAS",
+          "type": "Amplification"
+        },
+        {
+          "name": "MeshletsDepthPassMSCulled",
+          "type": "Mesh"
+        },
+        {
+          "name": "MeshletsDepthPassPS",
+          "type": "Fragment"
+        }
+      ]
+    },
+
+    "DrawList" : "depth"
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShaderLate.shader b/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShaderLate.shader
new file mode 100644
index 00000000000..2e781449897
--- /dev/null
+++ b/Gems/Meshlets/Assets/Shaders/MeshletsDepthMeshShaderLate.shader
@@ -0,0 +1,44 @@
+{
+    "Source" : "./MeshletsDepthMeshShader.azsl",
+
+    // Two-pass occlusion, PASS 2 (opt-in r_meshletsTwoPassOcclusion): same AS +
+    // payload depth MS as MeshletsDepthMeshShaderCulled.shader, but tagged for the
+    // gem-injected MeshletsLateDepthPass, which runs AFTER this frame's HiZ pyramid
+    // is reduced. Its instance SRG runs the AS in visMode 2: only clusters pass 1
+    // skipped are tested (against THIS frame's pyramid) and the disoccluded
+    // survivors complete the depth buffer — removing the one-frame disocclusion pop
+    // and guaranteeing the pyramid is never built from a feedback-culled depth.
+    //
+    // Depth state matches the depth prepass exactly (reverse-Z, write on).
+    "DepthStencilState" :
+    {
+        "Depth" :
+        {
+            "Enable" : true,
+            "CompareFunc" : "GreaterEqual"
+        }
+    },
+
+    "ProgramSettings":
+    {
+      "EntryPoints":
+      [
+        {
+          "name": "MeshletsCullClustersAS",
+          "type": "Amplification"
+        },
+        {
+          "name": "MeshletsDepthPassMSCulled",
+          "type": "Mesh"
+        },
+        {
+          "name": "MeshletsDepthPassPS",
+          "type": "Fragment"
+        }
+      ]
+    },
+
+    // Gem-private tag: routed ONLY to MeshletsLateDepthPass (injected after
+    // GpuCullAndDrawPass), never to the standard early DepthPrePass.
