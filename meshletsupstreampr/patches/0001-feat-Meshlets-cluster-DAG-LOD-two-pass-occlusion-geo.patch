+
+#pragma once
+
+// Phase 5 AS cluster cull — the SHARED amplification stage for every AS-culled
+// meshlet PSO (forward / depth / motion). One definition so the three passes can
+// never disagree on which clusters survive: each *Culled.shader lists
+// MeshletsCullClustersAS as its Amplification entry and pairs it with its own
+// payload-driven Mesh entry.
+//
+// Requires MeshletsMeshRenderSrg.azsli (MeshletsMeshObjectSrg /
+// MeshletsMeshInstanceSrg + MeshletsClusterCullMath.azsli) to be included first.
+
+// One AS threadgroup tests up to MESHLETS_AS_GROUP clusters (one cluster per lane),
+// compacts survivors via wave ballot, and DispatchMesh()'s exactly that many MS
+// groups. The outer (CPU-issued) AS group count is ceil(clusterCount / MESHLETS_AS_GROUP)
+// -- see MeshletsFeatureProcessor::EnsureMeshShaderResources.
+#define MESHLETS_AS_GROUP 128
+
+struct MeshletPayload
+{
+    uint m_clusterIds[MESHLETS_AS_GROUP];   //!< Mesh-local cluster id, valid for [0, survivorCount).
+};
+
+groupshared MeshletPayload s_meshletPayload;
+groupshared uint s_asSurvivorCount;
+
+//! Per-cluster cull test for the AS path. Composes the SAME pure functions
+//! MeshletsCull.azsl's ClusterVisible does (MeshletsClusterCullMath.azsli), against
+//! this shader's own bound resources (MeshletsMeshObjectSrg::m_clusterBounds +
+//! MeshletsMeshInstanceSrg's per-instance frustum/world/toggle constants).
+bool MeshletClusterVisible(uint clusterId)
+{
+    // Phase 4 streaming-exclusive gate: this mesh has no monolithic geometry, so
+    // until the page pool carries it (m_pagedMode) NOTHING may dispatch — any
+    // fallback fetch would read null stream buffers.
+    if (MeshletsMeshObjectSrg::m_pagedExclusive != 0u && MeshletsMeshObjectSrg::m_pagedMode == 0u)
+    {
+        return false;
+    }
+
+    // Phase 6 cluster-DAG cut — MUST run before the passthrough early-out below:
+    // when the cut is active the dispatch covers the FULL leaf+interior range and
+    // only cut-selected clusters may draw; when it is OFF (v2 pack, invalid
+    // projection stash, toggle transition) interior DAG clusters are refused
+    // outright so a DAG-range dispatch can never double-draw on top of leaves.
+    if (MeshletsMeshInstanceSrg::m_doDagCut != 0u)
+    {
+        const float2 errs = MeshletsDagNodeErrorsPx(
+            MeshletsMeshObjectSrg::m_dagNodes[clusterId],
+            MeshletsMeshInstanceSrg::m_worldRow0, MeshletsMeshInstanceSrg::m_worldRow1,
+            MeshletsMeshInstanceSrg::m_worldRow2,
+            MeshletsMeshInstanceSrg::m_cameraPosition.xyz,
+            MeshletsMeshInstanceSrg::m_dagProjScale);
+        if (errs.y <= MeshletsMeshInstanceSrg::m_dagErrorPx)
+        {
+            return false;   // parent group is good enough on screen — never draw
+        }
+        const bool isLeaf = clusterId < MeshletsMeshObjectSrg::m_leafClusterCount;
+        if (MeshletsMeshObjectSrg::m_pagedMode != 0u)
+        {
+            // Phase 7 fail-safe-coarse (design §3): a leaf whose group is not fully
+            // resident FAILS the cut, and its (always-resident) parent is FORCED to
+            // draw instead — group-shared bits keep it crack-free. m_pagedMode only
+            // turns on once every interior page is uploaded, so the forced parent
+            // always has data.
+            const uint map = MeshletsMeshObjectSrg::m_pagedClusterMap[clusterId];
+            const bool groupComplete = (map >> 31) != 0u;
+            const bool pageResident  = ((map >> 30) & 1u) != 0u;
+            if (isLeaf)
+            {
+                if (!groupComplete || !pageResident)
+                {
+                    return false;
+                }
+            }
+            else
+            {
+                if (!pageResident)
+                {
+                    return false;   // interior page missing (transient startup only)
+                }
+                if (errs.x > MeshletsMeshInstanceSrg::m_dagErrorPx && groupComplete)
+                {
+                    return false;   // children should refine — and they CAN (all resident)
+                }
+            }
+        }
+        else if (!isLeaf && errs.x > MeshletsMeshInstanceSrg::m_dagErrorPx)
+        {
+            return false;   // plain (non-paged) cut: interior too coarse — children draw
+        }
+    }
+    else
+    {
+        if (clusterId >= MeshletsMeshObjectSrg::m_leafClusterCount)
+        {
+            return false;   // interior DAG cluster with the cut off — leaves only
+        }
+        // Paged mode with the cut off: a leaf whose page is not resident must not
+        // dispatch — on a streaming-exclusive mesh there is no monolithic fallback
+        // to decode it from (and on a non-exclusive mesh this simply matches what
+        // the pool can serve; the monolithic path still draws when paging is off).
+        if (MeshletsMeshObjectSrg::m_pagedMode != 0u &&
+            ((MeshletsMeshObjectSrg::m_pagedClusterMap[clusterId] >> 30) & 1u) == 0u)
+        {
+            return false;
+        }
+    }
+
+    if (MeshletsMeshInstanceSrg::m_doFrustumCull == 0u &&
+        MeshletsMeshInstanceSrg::m_doConeCull == 0u &&
+        MeshletsMeshInstanceSrg::m_doHiZCull == 0u)
+    {
+        return true;   // passthrough -- matches MeshletsCull.azsl::ClusterVisible
+    }
+
+    const ClusterBoundsRecord b = MeshletsMeshObjectSrg::m_clusterBounds[clusterId];
+    const float maxScale = MeshletsMaxAxisScale(
+        MeshletsMeshInstanceSrg::m_worldRow0, MeshletsMeshInstanceSrg::m_worldRow1, MeshletsMeshInstanceSrg::m_worldRow2);
+    const float3 centerW = MeshletsTransformPoint(
+        MeshletsMeshInstanceSrg::m_worldRow0, MeshletsMeshInstanceSrg::m_worldRow1, MeshletsMeshInstanceSrg::m_worldRow2,
+        b.m_centerRadius.xyz);
+    const float radiusW = b.m_centerRadius.w * maxScale;
+    bool visible = true;
+
+    if (MeshletsMeshInstanceSrg::m_doFrustumCull != 0u &&
+        !MeshletsFrustumTestSphere(centerW, radiusW, MeshletsMeshInstanceSrg::m_frustumPlanes))
+    {
+        visible = false;
+    }
+
+    // HiZ: the feature processor binds the LAST-COMPLETED persistent pyramid (and the
+    // matching m_worldToClip) when the debug toggle is on; unbound/off it stays a safe
+    // no-op via the dimension check -- see MeshletsMeshRenderSrg.azsli's note.
+    if (visible && MeshletsMeshInstanceSrg::m_doHiZCull != 0u)
+    {
+        uint hiZW, hiZH;
+        MeshletsMeshInstanceSrg::m_hiZTexture.GetDimensions(hiZW, hiZH);
+        if (hiZW > 0 && hiZH > 0)
+        {
+            float4 ndcAabb = MeshletsProjectSphereToNdcAabb(centerW, radiusW, MeshletsMeshInstanceSrg::m_worldToClip);
+            float hiZDepth = MeshletsSampleHiZMin(ndcAabb, MeshletsMeshInstanceSrg::m_hiZTexture);
+            float closestDepth = MeshletsComputeClosestClusterDepth(
+                centerW, radiusW, MeshletsMeshInstanceSrg::m_cameraPosition.xyz, MeshletsMeshInstanceSrg::m_worldToClip);
+            if (closestDepth < hiZDepth)
+            {
+                visible = false;
+            }
+        }
+    }
+
+    const float coneCutoff = b.m_apexCutoff.w;
+    if (visible && MeshletsMeshInstanceSrg::m_doConeCull != 0u && coneCutoff < 1.0)
+    {
+        const float3 apexW = MeshletsTransformPoint(
+            MeshletsMeshInstanceSrg::m_worldRow0, MeshletsMeshInstanceSrg::m_worldRow1, MeshletsMeshInstanceSrg::m_worldRow2,
+            b.m_apexCutoff.xyz);
+        const float3 axisW = MeshletsTransformDir(
+            MeshletsMeshInstanceSrg::m_worldRow0, MeshletsMeshInstanceSrg::m_worldRow1, MeshletsMeshInstanceSrg::m_worldRow2,
+            b.m_axisPad.xyz);
+        if (MeshletsConeCulled(apexW, axisW, coneCutoff, MeshletsMeshInstanceSrg::m_cameraPosition.xyz))
+        {
+            visible = false;
+        }
+    }
+    return visible;
+}
+
+[numthreads(MESHLETS_AS_GROUP, 1, 1)]
+void MeshletsCullClustersAS(uint groupThreadId : SV_GroupThreadID, uint groupId : SV_GroupID)
+{
+    if (groupThreadId == 0)
+    {
+        s_asSurvivorCount = 0;
+    }
+    GroupMemoryBarrierWithGroupSync();
+
+    const uint clusterId = groupId * MESHLETS_AS_GROUP + groupThreadId;
+    const uint clusterCount = MeshletsMeshObjectSrg::m_clusterCount;
+    const bool inRange = clusterId < clusterCount;
+    bool visible = inRange;
+
+    // Two-pass occlusion, pass 2: only clusters pass 1 did NOT dispatch are
+    // candidates (the ledger holds this frame's id for everything pass 1 drew).
+    if (visible && MeshletsMeshInstanceSrg::m_visMode == 2u &&
+        MeshletsMeshInstanceSrg::m_clusterVisFrame[clusterId] == MeshletsMeshInstanceSrg::m_frameId)
+    {
+        visible = false;
+    }
+
+    visible = visible && MeshletClusterVisible(clusterId);
+
+    // Record survivors in the ledger (pass 1 and pass 2 both write; each lane
+    // owns a distinct index, so no atomics needed).
+    if (visible && MeshletsMeshInstanceSrg::m_visMode != 0u)
+    {
+        MeshletsMeshInstanceSrg::m_clusterVisFrame[clusterId] = MeshletsMeshInstanceSrg::m_frameId;
+    }
+
+    // Wave-ballot compaction: one atomic per WAVE (not per lane) reserves a
+    // contiguous payload slot range; each surviving lane writes at
+    // (wave's base slot + its popcount-prefix within the wave).
+    const uint4 ballot = WaveActiveBallot(visible);
+    const uint waveSurvivors = countbits(ballot.x) + countbits(ballot.y) + countbits(ballot.z) + countbits(ballot.w);
+    uint waveBase = 0;
+    if (WaveIsFirstLane())
+    {
+        InterlockedAdd(s_asSurvivorCount, waveSurvivors, waveBase);
+    }
+    waveBase = WaveReadLaneFirst(waveBase);
+
+    if (visible)
+    {
+        const uint slot = waveBase + WavePrefixCountBits(visible);
+        s_meshletPayload.m_clusterIds[slot] = clusterId;
+    }
+
+    GroupMemoryBarrierWithGroupSync();
+
+    // DispatchMesh must be called exactly once, uniformly, by every thread in the
+    // AS group (per the mesh-shader spec) -- NOT gated behind groupThreadId==0.
+    const uint survivorCount = s_asSurvivorCount;
+    DispatchMesh(survivorCount, 1, 1, s_meshletPayload);
+}
diff --git a/Gems/Meshlets/Assets/Shaders/MeshletsCullCompute.azsl b/Gems/Meshlets/Assets/Shaders/MeshletsCullCompute.azsl
deleted file mode 100644
index befdd9f6eb4..00000000000
--- a/Gems/Meshlets/Assets/Shaders/MeshletsCullCompute.azsl
+++ /dev/null
@@ -1,180 +0,0 @@
-/*
- * Copyright (c) Contributors to the Open 3D Engine Project.
- * For complete copyright and license terms please see the LICENSE at the root of this distribution.
- *
- * SPDX-License-Identifier: Apache-2.0 OR MIT
- *
- */
-
-// Meshlet GPU cluster-cull compute (Phase 6, GPU path — GROUNDWORK).
-//
-// One thread per cluster. Each thread frustum- and backface-cone-culls its
-// cluster against the (optionally frozen) camera and, if visible, atomically
-// appends a DrawIndexedIndirectCommand to the output buffer and bumps the draw
-// count. This mirrors the CPU MeshletsRenderObject::CullClustersToCommands math
-// 1:1 (same bounding-sphere frustum test, same meshopt normal-cone convention,
-// same {triCount*3, 1, triOffset*3, 0, 0} command), so a GPU-culled draw is
-// byte-identical to a CPU-culled one.
-//
-// NOTE: this kernel is validated by the Asset Processor but is not yet dispatched
-// at runtime. Wiring it requires the indirect-args UAV->INDIRECT barrier, which
-// in turn needs a gem-owned indirect consuming pass (see the Phase 6 plan doc).
-// The CPU cull remains the live path until that decision is made.
-
-#include <Atom/Features/SrgSemantics.azsli>
-#include <Atom/Features/IndirectRendering.azsli>
-
-#define MESHLETS_CULL_THREADS 64
-
-// Mirrors C++ Meshlets::ClusterBoundsRecord (48 bytes = 3x float4). HLSL packs
-// each float3+float pair into one 16-byte slot, matching the C++ layout.
-struct ClusterBoundsRecord
-{
-    float3 m_center;      // bounding-sphere center (object space)
-    float  m_radius;      // bounding-sphere radius (object space)
-    float3 m_coneApex;    // normal-cone apex (object space)
-    float  m_coneCutoff;  // cos(half-angle); cull when dot(axis, normalize(apex-eye)) >= cutoff
-    float3 m_coneAxis;    // normal-cone axis (unit, object space)
-    float  m_pad;
-};
-
-// Mirrors C++ Meshlets::ClusterDescriptor (16 bytes).
-struct ClusterDescriptor
-{
-    uint m_vertexOffset;
-    uint m_triangleOffset;   // in triangles
-    uint m_vertexCount;
-    uint m_triangleCount;    // in triangles
-};
-
-ShaderResourceGroup MeshletsCullSrg : SRG_PerDraw
-{
-    // --- Per-mesh inputs (shared across instances; PerObject in the wired design) ---
-    StructuredBuffer<ClusterBoundsRecord> m_clusterBounds;
-    StructuredBuffer<ClusterDescriptor>   m_clusterDescriptors;
-    uint m_clusterCount;
-
-    // --- Per-instance inputs ---
-    // Object->world (row-major; transforms column vectors via mul(M, v)).
-    row_major float4x4 m_objectToWorld;
-    // World->clip of the cull camera (live or frozen). Frustum planes derive from it.
-    row_major float4x4 m_worldToClip;
-    float3 m_cameraWorldPos;
-    // Conservative world-space radius scale (max object-space basis length).
-    // Precomputed on the CPU to avoid GPU-side matrix-convention pitfalls.
-    float  m_boundsScale;
-    uint   m_doFrustumCull;   // 0/1
-    uint   m_doConeCull;      // 0/1
-
-    // --- Outputs ---
-    // One DrawIndexedIndirectCommand per visible cluster, compacted.
-    RWStructuredBuffer<DrawIndexedIndirectCommand> m_outCommands;
-    // Atomic visible-cluster count == the indirect draw's command count.
-    RWByteAddressBuffer m_outCount;
-};
-
-// Inward-facing frustum planes from a row-major view-projection (Atom convention,
-// matches GpuFrustumCull.azsl). A point is inside when dot(plane.xyz, p) + plane.w >= 0.
-void ExtractFrustumPlanes(row_major float4x4 viewProj, out float4 planes[6])
-{
-    planes[0] = float4(viewProj[0][3] + viewProj[0][0], viewProj[1][3] + viewProj[1][0], viewProj[2][3] + viewProj[2][0], viewProj[3][3] + viewProj[3][0]); // Left
-    planes[1] = float4(viewProj[0][3] - viewProj[0][0], viewProj[1][3] - viewProj[1][0], viewProj[2][3] - viewProj[2][0], viewProj[3][3] - viewProj[3][0]); // Right
-    planes[2] = float4(viewProj[0][3] + viewProj[0][1], viewProj[1][3] + viewProj[1][1], viewProj[2][3] + viewProj[2][1], viewProj[3][3] + viewProj[3][1]); // Bottom
-    planes[3] = float4(viewProj[0][3] - viewProj[0][1], viewProj[1][3] - viewProj[1][1], viewProj[2][3] - viewProj[2][1], viewProj[3][3] - viewProj[3][1]); // Top
-    planes[4] = float4(viewProj[0][2],                  viewProj[1][2],                  viewProj[2][2],                  viewProj[3][2]);                  // Near
-    planes[5] = float4(viewProj[0][3] - viewProj[0][2], viewProj[1][3] - viewProj[1][2], viewProj[2][3] - viewProj[2][2], viewProj[3][3] - viewProj[3][2]); // Far
-
-    [unroll]
-    for (int i = 0; i < 6; ++i)
-    {
-        float len = length(planes[i].xyz);
-        planes[i] /= max(len, 1e-8);
-    }
-}
-
-// True if the sphere is at least partially inside the frustum.
-bool FrustumTestSphere(float4 planes[6], float3 center, float radius)
-{
-    [unroll]
-    for (int i = 0; i < 6; ++i)
-    {
-        if (dot(planes[i].xyz, center) + planes[i].w < -radius)
-        {
-            return false;
-        }
-    }
-    return true;
-}
-
-[numthreads(MESHLETS_CULL_THREADS, 1, 1)]
-void CullClusters(uint3 dispatchThreadId : SV_DispatchThreadID)
-{
-    const uint clusterId = dispatchThreadId.x;
-    if (clusterId >= MeshletsCullSrg::m_clusterCount)
-    {
-        return;
-    }
-
-    const ClusterBoundsRecord b = MeshletsCullSrg::m_clusterBounds[clusterId];
-    bool visible = true;
-
-    // --- Frustum cull against the world-space bounding sphere ---
-    if (MeshletsCullSrg::m_doFrustumCull != 0u)
-    {
-        const float3 centerW = mul(MeshletsCullSrg::m_objectToWorld, float4(b.m_center, 1.0)).xyz;
-        const float  radiusW = b.m_radius * MeshletsCullSrg::m_boundsScale;
-
-        float4 planes[6];
-        ExtractFrustumPlanes(MeshletsCullSrg::m_worldToClip, planes);
-        if (!FrustumTestSphere(planes, centerW, radiusW))
-        {
-            visible = false;
-        }
-    }
-
-    // --- Backface normal-cone cull (meshopt convention) ---
-    // Entirely back-facing when dot(normalize(apex - eye), axis) >= cutoff.
-    // cutoff >= 1 means meshopt produced no valid cone -> never cull.
-    if (visible && MeshletsCullSrg::m_doConeCull != 0u && b.m_coneCutoff < 1.0)
-    {
-        const float3 apexW = mul(MeshletsCullSrg::m_objectToWorld, float4(b.m_coneApex, 1.0)).xyz;
-        float3 axisW = mul((float3x3)MeshletsCullSrg::m_objectToWorld, b.m_coneAxis);
-        float3 toApex = apexW - MeshletsCullSrg::m_cameraWorldPos;
-        if (dot(axisW, axisW) > 1e-12 && dot(toApex, toApex) > 1e-12)
-        {
-            axisW = normalize(axisW);
-            toApex = normalize(toApex);
-            if (dot(toApex, axisW) >= b.m_coneCutoff)
-            {
-                visible = false;
-            }
-        }
-    }
-
-    if (!visible)
-    {
-        return;
-    }
-
-    // --- Emit a compacted DrawIndexedIndirectCommand for the visible cluster ---
-    const ClusterDescriptor cd = MeshletsCullSrg::m_clusterDescriptors[clusterId];
-
-    uint slot;
-    MeshletsCullSrg::m_outCount.InterlockedAdd(0, 1, slot);
-
-    uint maxCommands;
-    uint stride;
-    MeshletsCullSrg::m_outCommands.GetDimensions(maxCommands, stride);
-    if (slot >= maxCommands)
-    {
-        return;
-    }
-
-    DrawIndexedIndirectCommand cmd;
-    cmd.m_indexCountPerInstance = cd.m_triangleCount * 3u;
-    cmd.m_instanceCount         = 1u;
-    cmd.m_startIndexLocation    = cd.m_triangleOffset * 3u;
-    cmd.m_baseVertexLocation    = 0;
-    cmd.m_startInstanceLocation = 0u;
-    MeshletsCullSrg::m_outCommands[slot] = cmd;
-}
