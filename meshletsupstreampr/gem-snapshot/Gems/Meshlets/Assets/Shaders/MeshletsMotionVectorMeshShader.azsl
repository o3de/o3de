// Meshlet MOTION VECTOR pass — HARDWARE MESH SHADER path.
//
// The mesh-shader counterpart of MeshletsMotionVector.azsl (vertex-pull). Unlike
// the depth and shadow mesh shaders this one has a REAL pixel shader: it writes
// screen-space motion to a render target, so it carries world position for both the
// current and previous frame through to the PS.
//
// Motion vectors feed TAA and any upscaler (see the UpscalerInterface work), so
// leaving this pass on the vertex-pull path meant meshlet geometry paid the slower
// path on every frame TAA was enabled.
//
// NOTE ON OBJECT ID: the vertex-pull path resolves objectId through
// MeshletsInstanceRenderSrg::ResolveObjectId(SV_InstanceID) because it supports
// hardware-instanced draws. The mesh-shader path issues one DispatchMesh per
// instance, so there is no SV_InstanceID to resolve — it reads
// MeshletsMeshInstanceSrg::m_objectId directly, matching MeshletsDepthMeshShader
// and MeshletsForwardMeshShader. Each instance therefore still gets its OWN
// previous transform, which is what prevents ghosting.

#include <Atom/Features/SrgSemantics.azsli>
#include <viewsrg_all.srgi>
// Pulls in scenesrg_all.srgi + MeshletsMeshObjectSrg/MeshletsMeshInstanceSrg.
#include <MeshletsMeshRenderSrg.azsli>

// Must match the other meshlet mesh shaders — clusters are baked at <=128 verts /
// <=256 tris, within the DX12 mesh-shader per-group limits.
#define MESHLETS_MS_MAX_VERTICES   128
#define MESHLETS_MS_MAX_TRIANGLES  256
#define MESHLETS_MS_THREADS        128

struct VSOutput
{
    precise float4 m_position     : SV_Position;
    float3         m_worldPos     : TEXCOORD0;
    float3         m_worldPosPrev : TEXCOORD1;
};

struct PSOutput
{
    float2 m_motion : SV_Target0;   //!< R16G16_FLOAT screen-space motion vector.
};

[outputtopology("triangle")]
[numthreads(MESHLETS_MS_THREADS, 1, 1)]
void MeshletsMotionVectorMS(
    uint groupThreadId : SV_GroupThreadID,
    uint groupId       : SV_GroupID,
    out vertices VSOutput outVerts[MESHLETS_MS_MAX_VERTICES],
    out indices  uint3    outTris[MESHLETS_MS_MAX_TRIANGLES])
{
    // One threadgroup == one cluster. Decode mirrors MeshletsDepthPassMS exactly so
    // motion vectors cover precisely the fragments the depth prepass wrote.
    const MeshletDescriptor cluster = MeshletsMeshObjectSrg::m_meshletsDescriptors[groupId];

    const uint vertexCount   = min(cluster.m_vertexCount,   (uint)MESHLETS_MS_MAX_VERTICES);
    const uint triangleCount = min(cluster.m_triangleCount, (uint)MESHLETS_MS_MAX_TRIANGLES);
    SetMeshOutputCounts(vertexCount, triangleCount);

    const uint objectId = MeshletsMeshInstanceSrg::m_objectId;

    // KEEP both current AND previous object-to-world transforms — the previous one
    // is what drives the motion vector.
    const float4x4 worldMatrix     = SceneSrg::GetObjectToWorldMatrix(objectId);
    const float4x4 worldMatrixPrev = SceneSrg::GetObjectToWorldMatrixPrev(objectId);

    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
    {
        const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];
        const float3 localPos = MeshletsMeshObjectSrg::GetPosition(meshVertex);

        VSOutput o;
        o.m_worldPos     = mul(worldMatrix,     float4(localPos, 1.0)).xyz;
        o.m_worldPosPrev = mul(worldMatrixPrev, float4(localPos, 1.0)).xyz;
        o.m_position     = mul(ViewSrg::m_viewProjectionMatrix, float4(o.m_worldPos, 1.0));
        outVerts[v] = o;
    }

    // Unpacked 8-bit indices are cluster-LOCAL (0..vertexCount-1) and index the
    // emitted vertex array directly.
    for (uint t = groupThreadId; t < triangleCount; t += MESHLETS_MS_THREADS)
    {
        const uint encodedTri = MeshletsMeshObjectSrg::m_meshletsTriangles[cluster.m_triangleOffset + t];
        outTris[t] = uint3(
            (encodedTri      ) & 0xffu,
            (encodedTri >>  8) & 0xffu,
            (encodedTri >> 16) & 0xffu);
    }
}

// ---------------------------------------------------------------------------
// AS-culled variant (opt-in r_meshletsMsCullAS, MeshletsMotionVectorMeshShaderCulled.shader):
// same emit as MeshletsMotionVectorMS but driven by the shared cluster-cull AS's
// payload, matching the culled forward PSO's AS group counts (one geometry view
// per DrawPacket). No per-triangle cull — the motion pass depth-tests GreaterEqual
// against the prepass, so extra triangles resolve correctly.
// ---------------------------------------------------------------------------
#include <MeshletsCullAS.azsli>

[outputtopology("triangle")]
[numthreads(MESHLETS_MS_THREADS, 1, 1)]
void MeshletsMotionVectorMSCulled(
    uint groupThreadId : SV_GroupThreadID,
    uint groupId       : SV_GroupID,
    in payload MeshletPayload payload,
    out vertices VSOutput outVerts[MESHLETS_MS_MAX_VERTICES],
    out indices  uint3    outTris[MESHLETS_MS_MAX_TRIANGLES])
{
    // The AS only ever writes valid (< clusterCount) ids and dispatches exactly
    // survivorCount MS groups, so groupId indexes the payload directly.
    const uint clusterId = payload.m_clusterIds[groupId];
    const MeshletDescriptor cluster = MeshletsMeshObjectSrg::m_meshletsDescriptors[clusterId];

    const uint vertexCount   = min(cluster.m_vertexCount,   (uint)MESHLETS_MS_MAX_VERTICES);
    const uint triangleCount = min(cluster.m_triangleCount, (uint)MESHLETS_MS_MAX_TRIANGLES);
    SetMeshOutputCounts(vertexCount, triangleCount);

    const uint objectId = MeshletsMeshInstanceSrg::m_objectId;
    const float4x4 worldMatrix     = SceneSrg::GetObjectToWorldMatrix(objectId);
    const float4x4 worldMatrixPrev = SceneSrg::GetObjectToWorldMatrixPrev(objectId);

    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
    {
        const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];
        const float3 localPos = MeshletsMeshObjectSrg::GetPosition(meshVertex);

        VSOutput o;
        o.m_worldPos     = mul(worldMatrix,     float4(localPos, 1.0)).xyz;
        o.m_worldPosPrev = mul(worldMatrixPrev, float4(localPos, 1.0)).xyz;
        o.m_position     = mul(ViewSrg::m_viewProjectionMatrix, float4(o.m_worldPos, 1.0));
        outVerts[v] = o;
    }

    for (uint t = groupThreadId; t < triangleCount; t += MESHLETS_MS_THREADS)
    {
        const uint encodedTri = MeshletsMeshObjectSrg::m_meshletsTriangles[cluster.m_triangleOffset + t];
        outTris[t] = uint3(
            (encodedTri      ) & 0xffu,
            (encodedTri >>  8) & 0xffu,
            (encodedTri >> 16) & 0xffu);
    }
}

// Identical maths to MeshletsMotionVectorPS on the vertex-pull path, so both paths
// produce the same motion buffer.
PSOutput MeshletsMotionVectorMeshPS(VSOutput IN)
{
    PSOutput OUT;

    const float4 clipPos     = mul(ViewSrg::m_viewProjectionMatrix,     float4(IN.m_worldPos, 1.0));
    const float4 clipPosPrev = mul(ViewSrg::m_viewProjectionPrevMatrix, float4(IN.m_worldPosPrev, 1.0));

    float2 motion = (clipPos.xy / clipPos.w - clipPosPrev.xy / clipPosPrev.w) * 0.5;
    // Flip Y to line up with UV coordinates (matches the standard mesh path).
    motion.y = -motion.y;

    OUT.m_motion = motion;
    return OUT;
}
