// Meshlet forward pass — HARDWARE MESH SHADER path (Phase 5, first slice).
//
// Rendered by the STANDARD Atom ForwardPass (DrawListTag "forward"), exactly like
// the vertex-pull MeshletsForwardPass.azsl, so it inherits the ForwardPassSrg
// lighting resources for free. This first slice runs one threadgroup per cluster
// (DispatchMesh(clusterCount,1,1)) with NO amplification/cull stage yet — the mesh
// shader transforms each cluster's vertices and emits its triangles directly (no
// input assembler, no index buffer). The pixel shader outputs a flat per-cluster
// debug color so the meshlet decomposition is directly visible and correctness of
// the mesh-shader emit can be verified before wiring the full PBR path.
//
// Decode of the cluster triangle/vertex data mirrors MeshletsCompute.azsl's
// GetGlobalVertexIndicesAndTriOffset exactly.

// Enable tile-based light culling (the ForwardPass provides m_tileLightData +
// m_lightListRemapped). Must be set BEFORE the lighting headers are included.
#define ENABLE_LIGHT_CULLING    1

#include <Atom/Features/SrgSemantics.azsli>
#include <viewsrg_all.srgi>
// MeshletsMeshRenderSrg pulls in scenesrg_all.srgi (SceneSrg::GetObjectToWorldMatrix).
#include <MeshletsMeshRenderSrg.azsli>

// Standard forward pass SRG (SRG_PerPass): shadowmaps, tile light data, BRDF map,
// samplers. Bound by the standard Atom ForwardPass for the whole pass, so the mesh
// path (DrawListTag "forward") inherits it for free — exactly like the vertex-pull
// MeshletsForwardPass.azsl. PerPass carries no ShaderVariantFallback, so it does not
// collide with the PerDraw fallback SRG (MeshletsMeshInstanceSrg).
#include <Atom/Features/Pipeline/Forward/ForwardPassSrg.azsli>

// Per-material SRG (SRG_PerMaterial, space 2): the source model's PBR textures +
// factors, populated at runtime (EnsureMaterialSrg) and bound on the mesh DrawItem
// by the feature processor. No frequency collision with PerDraw/PerObject.
#include <MeshletsMaterialSrg.azsli>

// AcesCg color conversion + opacity option + StandardPBR lighting + Fresnel. The MS
// entry ignores these (dead-stripped by ms_6_5); only the PBR pixel shader uses them.
#include <Atom/Features/ColorManagement/TransformColor.azsli>
#include <Atom/Features/PBR/AlphaUtils.azsli>
#include <Atom/Features/PBR/Lighting/StandardLighting.azsli>
#include <Atom/Features/PBR/Microfacet/Fresnel.azsli>

// 5-target MainPipeline forward output (diffuse, specular, albedo, specularF0, normal).
#include <Atom/Features/Pipeline/Forward/ForwardPassOutput.azsli>

// Mesh-shader output limits. Clusters are baked at <=128 verts / <=256 tris, both
// within the DX12 mesh-shader per-group limits (256 verts / 256 prims).
#define MESHLETS_MS_MAX_VERTICES   128
#define MESHLETS_MS_MAX_TRIANGLES  256
#define MESHLETS_MS_THREADS        128

struct VSOutput
{
    float4 m_position      : SV_Position;
    float3 m_normal        : NORMAL;
    // .xyz = world tangent, .w = bitangent winding sign. The bitangent is
    // reconstructed in the PS as sign * cross(N, T) (MikkTSpace convention, which is
    // how the O3DE scene pipeline defines that sign) rather than carried as its own
    // interpolant -- saves one SRV read per vertex and one float3 interpolant.
    float4 m_tangent       : TANGENT;
    float3 m_worldPosition : UV0;
    float2 m_uv            : UV1;
    nointerpolation uint m_clusterId : UV2;
};

[outputtopology("triangle")]
[numthreads(MESHLETS_MS_THREADS, 1, 1)]
void MeshletsForwardPassMS(
    uint groupThreadId : SV_GroupThreadID,
    uint groupId       : SV_GroupID,
    out vertices VSOutput outVerts[MESHLETS_MS_MAX_VERTICES],
    out indices  uint3    outTris[MESHLETS_MS_MAX_TRIANGLES])
{
    // One threadgroup == one cluster. m_meshletsDescriptors is re-based per-mesh,
    // so SV_GroupID indexes it directly.
    const MeshletDescriptor cluster = MeshletsMeshObjectSrg::m_meshletsDescriptors[groupId];

    const uint vertexCount   = min(cluster.m_vertexCount,   (uint)MESHLETS_MS_MAX_VERTICES);
    const uint triangleCount = min(cluster.m_triangleCount, (uint)MESHLETS_MS_MAX_TRIANGLES);
    SetMeshOutputCounts(vertexCount, triangleCount);

    const uint objectId = MeshletsMeshInstanceSrg::m_objectId;
    const float4x4 objectToWorld  = SceneSrg::GetObjectToWorldMatrix(objectId);
    const float3x3 objectToWorldIT = SceneSrg::GetObjectToWorldInverseTransposeMatrix(objectId);

    // Emit this cluster's vertices. Each thread strides the local-vertex range.
    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
    {
        // Cluster-local vertex index -> mesh global vertex index.
        const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];

        const float3 localPos = MeshletsMeshObjectSrg::GetPosition(meshVertex);
        const float3 worldPos = mul(objectToWorld, float4(localPos, 1.0)).xyz;

        const float3 vNormal  = MeshletsMeshObjectSrg::GetNormal(meshVertex);
        const float4 vTangent = MeshletsMeshObjectSrg::GetTangent(meshVertex);

        // No per-vertex normalize(): the PS re-normalizes N and T before building the
        // tangent frame, so normalizing here is redundant work on the hotter stage.
        VSOutput o;
        o.m_worldPosition = worldPos;
        o.m_position      = mul(ViewSrg::m_viewProjectionMatrix, float4(worldPos, 1.0));
        o.m_normal        = mul(objectToWorldIT, vNormal);
        o.m_tangent       = float4(mul(objectToWorld, float4(vTangent.xyz, 0.0)).xyz, vTangent.w);
        o.m_uv            = MeshletsMeshObjectSrg::GetUV(meshVertex);
        o.m_clusterId     = groupId;
        outVerts[v] = o;
    }

    // Emit this cluster's triangles. The unpacked 8-bit indices are cluster-LOCAL
    // (0..vertexCount-1) and index the emitted vertex array directly.
    for (uint t = groupThreadId; t < triangleCount; t += MESHLETS_MS_THREADS)
    {
        const uint encodedTri = MeshletsMeshObjectSrg::m_meshletsTriangles[cluster.m_triangleOffset + t];
        outTris[t] = uint3(
            (encodedTri      ) & 0xffu,
            (encodedTri >>  8) & 0xffu,
            (encodedTri >> 16) & 0xffu);
    }
}

// ============================================================================
// Phase 5 -- AMPLIFICATION-SHADER cluster cull + PER-TRIANGLE cull (opt-in,
// r_meshletsMsCullAS; default OFF -- MeshletsForwardPassMS above is untouched and
// stays the default DispatchMesh(clusterCount,1,1) path with no cull stage).
//
// This is a SEPARATE entry-point pair from MeshletsForwardPassMS, compiled into a
// SEPARATE .shader/PSO (MeshletsForwardMeshShaderCulled.shader) that adds the
// Amplification stage. Adding an AS to the SAME .shader as the default MS entry
// would make every DispatchMesh call through it invoke the AS unconditionally --
// that would change the shipped default's behavior, which HARD RULE 7 forbids.
//
// Both PSOs share this one .azsl file (and its PS) so the shipped default is
// byte-for-byte unchanged; only a new PSO opts in.
// ============================================================================

// The AS entry (MeshletsCullClustersAS), payload struct and per-cluster cull test
// are SHARED with the depth/motion AS-culled PSOs -- one definition so the three
// passes can never disagree on which clusters survive.
#include <MeshletsCullAS.azsli>

// ---------------------------------------------------------------------------
// Per-triangle cull (Item 2): backface + degenerate + micro-polygon, evaluated
// after vertices are transformed but before SetMeshOutputCounts commits a
// triangle count. MUST be conservative (reverse-Z everywhere; a false cull
// silently drops geometry) -- any ambiguous case (near-plane straddle, etc.)
// is left un-culled.
// ---------------------------------------------------------------------------
// NOTE: SetMeshOutputCounts must be called exactly once, uniformly, by every thread,
// and — per the mesh-shader spec — BEFORE any thread writes to the out vertices/
// indices arrays. The final triangle count isn't known until after the per-triangle
// cull runs, so vertices are staged into this groupshared buffer (not outVerts)
// first; only after SetMeshOutputCounts is called do threads copy the staged data
// into outVerts/outTris.
// LDS budget: the per-triangle cull only reads each vertex CLIP position, so only
// that is staged -- plus the world position, purely so the emit pass below does not
// have to re-read and re-transform the position stream. ~2KB + 1.5KB + 3KB = 6.5KB
// per group instead of the ~13KB a staged VSOutput[128] cost, which is the difference
// between one and two resident groups per SIMD against the 32KB RDNA LDS budget. The
// remaining attributes (normal/tangent/uv) are read straight into outVerts after
// SetMeshOutputCounts -- the same number of SRV reads as before, just issued later.
groupshared float4 s_clipPos[MESHLETS_MS_MAX_VERTICES];
groupshared float3 s_worldPos[MESHLETS_MS_MAX_VERTICES];
groupshared uint3  s_survivingTris[MESHLETS_MS_MAX_TRIANGLES];
groupshared uint   s_survivingTriCount;

//! True if the triangle should be CULLED (backfacing or degenerate). Skips (never
//! culls) any triangle with a vertex behind the camera (w<=0) -- the near-plane clip
//! changes topology in ways this simple test can't reason about.
//! The pixel-size gates use the real render-target height via
//! MeshletsMeshInstanceSrg::m_viewportSize (wired per frame by
//! UpdateMeshShaderCullInstance), with 1080 as a first-frame fallback.
bool TriangleCulled(float4 c0, float4 c1, float4 c2)
{
    if (c0.w <= 0.0 || c1.w <= 0.0 || c2.w <= 0.0)
    {
        return false;   // conservative: don't reason about near-plane-straddling triangles
    }

    // NDC, then flip Y to match the screen-space winding convention
    // FrontCounterClockwise=true is defined in (Atom's DX12 backend sets
    // FrontCounterClockwise=true; screen space is Y-down while NDC is Y-up -- the
    // same flip used for NDC->UV elsewhere in this gem, see
    // MeshletsClusterCullMath.azsli::MeshletsProjectSphereToNdcAabb).
    const float2 p0 = float2(c0.x / c0.w, -c0.y / c0.w);
    const float2 p1 = float2(c1.x / c1.w, -c1.y / c1.w);
    const float2 p2 = float2(c2.x / c2.w, -c2.y / c2.w);

    // Signed area * 2 in that screen-sense (Y-down) space. Because Y is flipped relative to standard
    // math convention, this formula's sign is inverted from the usual "positive = CCW" rule: NEGATIVE
    // = counter-clockwise-on-screen = front-facing (FrontCounterClockwise=true), POSITIVE = clockwise
    // = back-facing. Verified by hand against a concrete screen-space CCW triangle (e.g. TL,BL,BR):
    // its NDC-space equivalent evaluates to signedArea < 0 here.
    const float signedArea = (p1.x - p0.x) * (p2.y - p0.y) - (p2.x - p0.x) * (p1.y - p0.y);

    const float degenerateEpsilon = 1e-9;
    if (abs(signedArea) < degenerateEpsilon)
    {
        return true;   // degenerate (zero-area / collapsed) triangle
    }
    if (signedArea >= 0.0)
    {
        return true;   // back-facing (positive = clockwise-on-screen here) -- the rasterizer's
                        // CullMode::Back would drop it anyway
    }

    // Micro-polygon: projected AABB smaller than roughly a pixel. Uses the real
    // render-target height (MeshletsMeshInstanceSrg::m_viewportSize, set every
    // frame by UpdateMeshShaderCullInstance); 1080 only as a fallback while the
    // constant hasn't been written yet.
    const float2 aabbMin = min(p0, min(p1, p2));
    const float2 aabbMax = max(p0, max(p1, p2));
    const float refHeightPixels =
        (MeshletsMeshInstanceSrg::m_viewportSize.y > 0.0) ? MeshletsMeshInstanceSrg::m_viewportSize.y : 1080.0;
    const float pixelSizeNdc = 2.0 / refHeightPixels;
    if (max(aabbMax.x - aabbMin.x, aabbMax.y - aabbMin.y) < pixelSizeNdc * 0.5)
    {
        return true;   // sub-pixel: no sample point can land inside with useful probability
    }
    return false;
}

//! True if the triangle is entirely occluded per the previous-frame HiZ pyramid
//! (spec Phase 5 "big-triangle HiZ" test). Projects with the PYRAMID's own
//! world->clip (MeshletsMeshInstanceSrg::m_worldToClip -- last frame's camera, set
//! by UpdateMeshShaderCullInstance), NOT this frame's ViewSrg matrix, so the depth
//! comparison happens in the clip space the pyramid was reduced in. Conservative:
//! never culls near-plane straddlers, unbound pyramids, or small triangles (4
//! pyramid taps + 3 matrix muls cost more than rasterizing them).
bool TriangleOccludedHiZ(float3 w0, float3 w1, float3 w2)
{
    uint hiZW, hiZH;
    MeshletsMeshInstanceSrg::m_hiZTexture.GetDimensions(hiZW, hiZH);
    if (hiZW == 0 || hiZH == 0)
    {
        return false;   // pyramid not bound -- same "optional" contract as the cluster test
    }

    const float4 c0 = mul(MeshletsMeshInstanceSrg::m_worldToClip, float4(w0, 1.0));
    const float4 c1 = mul(MeshletsMeshInstanceSrg::m_worldToClip, float4(w1, 1.0));
    const float4 c2 = mul(MeshletsMeshInstanceSrg::m_worldToClip, float4(w2, 1.0));
    if (c0.w <= 0.0 || c1.w <= 0.0 || c2.w <= 0.0)
    {
        return false;   // conservative near-plane handling, as in TriangleCulled
    }
    const float3 ndc0 = c0.xyz / c0.w;
    const float3 ndc1 = c1.xyz / c1.w;
    const float3 ndc2 = c2.xyz / c2.w;

    // Big-triangle gate (~>16px at the real render-target height, 1080 fallback):
    // below that, the test costs more than letting early-Z kill the pixels.
    const float2 ndcMin = min(ndc0.xy, min(ndc1.xy, ndc2.xy));
    const float2 ndcMax = max(ndc0.xy, max(ndc1.xy, ndc2.xy));
    const float gateHeightPixels =
        (MeshletsMeshInstanceSrg::m_viewportSize.y > 0.0) ? MeshletsMeshInstanceSrg::m_viewportSize.y : 1080.0;
    const float bigTriangleNdc = (2.0 / gateHeightPixels) * 16.0;
    if (max(ndcMax.x - ndcMin.x, ndcMax.y - ndcMin.y) < bigTriangleNdc)
    {
        return false;
    }

    // NDC -> [0,1] UV AABB (Y flip) -- the same mapping as
    // MeshletsClusterCullMath.azsli::MeshletsProjectSphereToNdcAabb.
    const float2 uvMin = saturate(float2(ndcMin.x, -ndcMax.y) * 0.5 + 0.5);
    const float2 uvMax = saturate(float2(ndcMax.x, -ndcMin.y) * 0.5 + 0.5);
    const float hiZDepth = MeshletsSampleHiZMin(float4(uvMin, uvMax), MeshletsMeshInstanceSrg::m_hiZTexture);

    // Reverse-Z: the triangle's CLOSEST point is its max depth. Entirely occluded
    // only if even that is farther (smaller) than the farthest occluder sample
    // under the footprint -- the same convention as the cluster-level test.
    const float closestDepth = saturate(max(ndc0.z, max(ndc1.z, ndc2.z)));
    return closestDepth < hiZDepth;
}

[outputtopology("triangle")]
[numthreads(MESHLETS_MS_THREADS, 1, 1)]
void MeshletsForwardPassMSCulled(
    uint groupThreadId : SV_GroupThreadID,
    uint groupId       : SV_GroupID,
    in payload MeshletPayload payload,
    out vertices VSOutput outVerts[MESHLETS_MS_MAX_VERTICES],
    out indices  uint3    outTris[MESHLETS_MS_MAX_TRIANGLES])
{
    // The AS only ever writes valid (< clusterCount) ids and dispatches exactly
    // survivorCount MS groups, so groupId indexes the payload directly.
    const uint clusterId = payload.m_clusterIds[groupId];
    const MeshletDescriptor cluster = MeshletsMeshObjectSrg::m_meshletsDescriptors[clusterId];

    const uint vertexCount = min(cluster.m_vertexCount, (uint)MESHLETS_MS_MAX_VERTICES);
    const uint triangleCandidateCount = min(cluster.m_triangleCount, (uint)MESHLETS_MS_MAX_TRIANGLES);

    if (groupThreadId == 0)
    {
        s_survivingTriCount = 0;
    }

    const uint objectId = MeshletsMeshInstanceSrg::m_objectId;
    const float4x4 objectToWorld  = SceneSrg::GetObjectToWorldMatrix(objectId);
    const float3x3 objectToWorldIT = SceneSrg::GetObjectToWorldInverseTransposeMatrix(objectId);

    // Phase 7 streaming: when paged mode is on, EVERY cluster the AS can dispatch
    // has a resident pool slot (the AS refused anything else), so geometry is
    // fetched from the page pool instead of the monolithic buffers. Resolved once
    // per group — groupId/clusterId are uniform.
    const MeshletsPagedCluster pagedCluster =
        (MeshletsMeshObjectSrg::m_pagedMode != 0u)
            ? MeshletsMeshObjectSrg::GetPagedCluster(clusterId)
            : (MeshletsPagedCluster)0;
    const bool paged = pagedCluster.m_valid != 0u;

    // Stage ONLY what the per-triangle cull needs (clip position), plus the world
    // position so the emit pass does not re-read the position stream. Everything else
    // is fetched after SetMeshOutputCounts -- see the LDS note above s_clipPos.
    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
    {
        float3 localPos;
        if (paged)
        {
            localPos = MeshletsMeshObjectSrg::GetPagedPosition(
                pagedCluster, MeshletsMeshObjectSrg::GetPagedVertexId(pagedCluster, v));
        }
        else
        {
            const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];
            localPos = MeshletsMeshObjectSrg::GetPosition(meshVertex);
        }
        const float3 worldPos = mul(objectToWorld, float4(localPos, 1.0)).xyz;

        s_worldPos[v] = worldPos;
        s_clipPos[v]  = mul(ViewSrg::m_viewProjectionMatrix, float4(worldPos, 1.0));
    }

    // Barrier: every thread's staged vertex write above (and the counter reset)
    // must be visible before any thread reads them in the triangle loop.
    GroupMemoryBarrierWithGroupSync();

    // Per-triangle cull, wave-ballot compacted into s_survivingTris (dense).
    for (uint t = groupThreadId; t < triangleCandidateCount; t += MESHLETS_MS_THREADS)
    {
        const uint encodedTri = paged
            ? MeshletsMeshObjectSrg::GetPagedTriangleWord(pagedCluster, t)
            : MeshletsMeshObjectSrg::m_meshletsTriangles[cluster.m_triangleOffset + t];
        const uint3 localTri = uint3(
            (encodedTri      ) & 0xffu,
            (encodedTri >>  8) & 0xffu,
            (encodedTri >> 16) & 0xffu);

        bool keep = !TriangleCulled(
            s_clipPos[localTri.x],
            s_clipPos[localTri.y],
            s_clipPos[localTri.z]);

        // Big-triangle HiZ occlusion (only when the FP resolved a pyramid this
        // frame): tested LAST so the cheap backface/degenerate/micro tests have
        // already filtered most candidates.
        if (keep && MeshletsMeshInstanceSrg::m_doHiZCull != 0u)
        {
            keep = !TriangleOccludedHiZ(
                s_worldPos[localTri.x],
                s_worldPos[localTri.y],
                s_worldPos[localTri.z]);
        }

        const uint4 ballot = WaveActiveBallot(keep);
        const uint waveSurvivors = countbits(ballot.x) + countbits(ballot.y) + countbits(ballot.z) + countbits(ballot.w);
        uint waveBase = 0;
        if (WaveIsFirstLane())
        {
            InterlockedAdd(s_survivingTriCount, waveSurvivors, waveBase);
        }
        waveBase = WaveReadLaneFirst(waveBase);

        if (keep)
        {
            const uint slot = waveBase + WavePrefixCountBits(keep);
            s_survivingTris[slot] = localTri;
        }
    }

    // Barrier: every thread's survivor-list write above must be visible, and
    // s_survivingTriCount must hold its FINAL value, before SetMeshOutputCounts.
    GroupMemoryBarrierWithGroupSync();

    const uint finalTriCount = s_survivingTriCount;
    // Must be called exactly once, uniformly, by every thread -- and (per the
    // mesh-shader spec) BEFORE any write to outVerts/outTris below.
    SetMeshOutputCounts(vertexCount, finalTriCount);

    // Emit pass. Position comes from the staged clip/world values (so the position
    // stream is still read exactly once); the remaining attributes are fetched now,
    // straight into outVerts, instead of having occupied LDS since the staging loop.
    // Each thread only touches the same v it staged, so no extra barrier is needed.
    for (uint v = groupThreadId; v < vertexCount; v += MESHLETS_MS_THREADS)
    {
        float3 vNormal;
        float4 vTangent;
        float2 vUv;
        if (paged)
        {
            const uint pageVertex = MeshletsMeshObjectSrg::GetPagedVertexId(pagedCluster, v);
            vNormal  = MeshletsMeshObjectSrg::GetPagedNormal(pagedCluster, pageVertex);
            vTangent = MeshletsMeshObjectSrg::GetPagedTangent(pagedCluster, pageVertex);
            vUv      = MeshletsMeshObjectSrg::GetPagedUV(pagedCluster, pageVertex);
        }
        else
        {
            const uint meshVertex = MeshletsMeshObjectSrg::m_meshletsIndicesLookup[cluster.m_vertexOffset + v];
            vNormal  = MeshletsMeshObjectSrg::GetNormal(meshVertex);
            vTangent = MeshletsMeshObjectSrg::GetTangent(meshVertex);
            vUv      = MeshletsMeshObjectSrg::GetUV(meshVertex);
        }

        VSOutput o;
        o.m_worldPosition = s_worldPos[v];
        o.m_position      = s_clipPos[v];
        o.m_normal        = mul(objectToWorldIT, vNormal);
        o.m_tangent       = float4(mul(objectToWorld, float4(vTangent.xyz, 0.0)).xyz, vTangent.w);
        o.m_uv            = vUv;
        o.m_clusterId     = clusterId;
        outVerts[v] = o;
    }
    for (uint w = groupThreadId; w < finalTriCount; w += MESHLETS_MS_THREADS)
    {
        outTris[w] = s_survivingTris[w];
    }
}

// Full PBR pixel shader — byte-for-byte the vertex-pull MeshletsForwardPass.azsl PS
// body, except that the bitangent is reconstructed from m_tangent.w here rather than
// interpolated. Everything downstream of the tangent frame -- material sampling /
// Surface build / lighting / 5-target pack -- is literal reuse. Result: a mesh-shader-drawn mesh looks identical to a
// standard mesh using the same MaterialAsset.
ForwardPassOutput MeshletsForwardMeshShaderPS(VSOutput IN)
{
    // ---------------- Debug: flat per-cluster (meshlet) color ----------------
    // When enabled (MeshletsMeshObjectSrg::m_meshletDebugColor != 0) bypass PBR and
    // emit a flat unlit color keyed off the cluster id so the meshlet decomposition
    // is directly visible. Output as emissive with zero albedo/diffuse/F0 so IBL/SSR
    // passes add nothing.
    if (MeshletsMeshObjectSrg::m_meshletDebugColor != 0u)
    {
        float3 clusterColor;
        if (MeshletsMeshObjectSrg::m_meshletDebugColor == 2u)
        {
            // Phase 6 DAG-depth mode: leaves (selfError == 0) render a flat blue-gray;
            // coarser levels hash their quantized log2 error to a hue, so the cut
            // boundary (and any crack) is directly visible. Unbound m_dagNodes (v2
            // pack) reads zeros => everything shows as leaf, which is the truth.
            const float selfErr = MeshletsMeshObjectSrg::m_dagNodes[IN.m_clusterId].m_errors.x;
            if (selfErr <= 0.0)
            {
                clusterColor = float3(0.35, 0.45, 0.65);
            }
            else
            {
                const uint errBucket = uint(clamp(log2(selfErr * 1.0e4 + 1.0), 0.0, 31.0));
                clusterColor = MeshletsMeshObjectSrg::MeshletDebugColor(errBucket);
            }
        }
        else
        {
            clusterColor = MeshletsMeshObjectSrg::MeshletDebugColor(IN.m_clusterId);
        }
        ForwardPassOutput dbg = (ForwardPassOutput)0;
        dbg.m_diffuseColor  = float4(0.0, 0.0, 0.0, -1.0);   // a=-1 disables SSS
        dbg.m_specularColor = float4(clusterColor, 0.0);     // emissive-add path
        dbg.m_albedo        = float4(0.0, 0.0, 0.0, 1.0);
        dbg.m_specularF0    = float4(0.0, 0.0, 0.0, 0.0);
        dbg.m_normal        = float4(normalize(IN.m_normal) * 0.5 + 0.5, 0.0);
        return dbg;
    }

    float3 views[MAX_SHADING_VIEWS];
    views[0] = ViewSrg::m_worldPosition.xyz;   // Single view for the forward pass.

    // ---------------- Sample the material ----------------
    // Combine rules mirror StandardPBR's *Input.azsli convention exactly, so a
    // meshlet material looks identical to a standard mesh using the same MaterialAsset.
    const uint matFlags = MeshletsMaterialSrg::m_flags;
    const float2 uv = IN.m_uv;

    real3 baseColor = (real3)MeshletsMaterialSrg::m_baseColor.rgb;
    if (matFlags & MESHLETS_MAT_FLAG_BASECOLOR_MAP)
    {
        real3 sampledAlbedo = (real3)MeshletsMaterialSrg::m_baseColorMap.Sample(MeshletsMaterialSrg::m_sampler, uv).rgb;
        sampledAlbedo = LinearSrgb_To_AcesCg(sampledAlbedo);
        baseColor *= sampledAlbedo;
    }

    // Metallic: texture takes precedence over factor when the map is bound.
    real metallic;
    if (matFlags & MESHLETS_MAT_FLAG_METALLIC_MAP)
    {
        metallic = (real)MeshletsMaterialSrg::m_metallicMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
    }
    else
    {
        metallic = (real)MeshletsMaterialSrg::m_metallicFactor;
    }

    // Roughness: with a texture, remap by lerp(lower, upper, tex.r) per StandardPBR.
    real roughness;
    if (matFlags & MESHLETS_MAT_FLAG_ROUGHNESS_MAP)
    {
        const real roughR = (real)MeshletsMaterialSrg::m_roughnessMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
        roughness = lerp(
            (real)MeshletsMaterialSrg::m_roughnessLowerBound,
            (real)MeshletsMaterialSrg::m_roughnessUpperBound,
            roughR);
    }
    else
    {
        roughness = (real)MeshletsMaterialSrg::m_roughnessFactor;
    }

    // Normal: BC5/RG normal map convention. Sample .rg, decode to [-1,1], swap to
    // (Y,X), scale XY by normalFactor, reconstruct Z, transform tangent->world.
    real3 normalWS = normalize((real3)IN.m_normal);
    if (matFlags & MESHLETS_MAT_FLAG_NORMAL_MAP)
    {
        real2 sampleRG = (real2)MeshletsMaterialSrg::m_normalMap.Sample(MeshletsMaterialSrg::m_sampler, uv).rg * 2.0 - 1.0;
        real2 tangentXY = sampleRG.yx;
        tangentXY *= (real)MeshletsMaterialSrg::m_normalFactor;
        const real tangentZ = max(sqrt(saturate(1.0 - dot(tangentXY, tangentXY))), 0.01);
        const real3 T = normalize((real3)IN.m_tangent.xyz);
        const real3 N = normalize((real3)IN.m_normal);
        // MikkTSpace: B = sign * cross(N, T). Reconstructed, not interpolated.
        const real3 B = cross(N, T) * (real)IN.m_tangent.w;
        normalWS = normalize(tangentXY.x * T + tangentXY.y * B + tangentZ * N);
    }

    // Ambient occlusion: occlusion = pow(tex.r, factor) when bound, else 1.0.
    real diffuseAO = 1.0;
    if (matFlags & MESHLETS_MAT_FLAG_DIFFUSE_AO_MAP)
    {
        const real aoR = (real)MeshletsMaterialSrg::m_diffuseOcclusionMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
        diffuseAO = pow(aoR, (real)MeshletsMaterialSrg::m_diffuseOcclusionFactor);
    }
    real specularAO = 1.0;
    if (matFlags & MESHLETS_MAT_FLAG_SPECULAR_AO_MAP)
    {
        const real aoR = (real)MeshletsMaterialSrg::m_specularOcclusionMap.Sample(MeshletsMaterialSrg::m_sampler, uv).r;
        specularAO = pow(aoR, (real)MeshletsMaterialSrg::m_specularOcclusionFactor);
    }

    // Emissive: pre-multiplied color * intensity, modulated by the map if bound.
    real3 emissive = (real3)MeshletsMaterialSrg::m_emissiveColor * (real)MeshletsMaterialSrg::m_emissiveIntensity;
    if (matFlags & MESHLETS_MAT_FLAG_EMISSIVE_MAP)
    {
        emissive *= (real3)MeshletsMaterialSrg::m_emissiveMap.Sample(MeshletsMaterialSrg::m_sampler, uv).rgb;
    }

    // ---------------- Build the surface ----------------
    Surface surface = (Surface)0;
    surface.position = IN.m_worldPosition;
    surface.vertexNormal = normalize((real3)IN.m_normal);
    surface.normal = normalWS;
    surface.lightingChannels = 0xFFFFFFFF;
    surface.SetAlbedoAndSpecularF0(baseColor, 0.5, metallic);
    surface.roughnessLinear = roughness;
    surface.CalculateRoughnessA();
    surface.emissiveLighting = emissive;
    surface.diffuseAmbientOcclusion = diffuseAO;
    surface.specularOcclusion = specularAO;

    // ---------------- Initialize lighting data ----------------
    LightingData lightingData;
    lightingData.Init(surface.position, surface.GetSpecularNormal(), surface.roughnessLinear, views);
    lightingData.specularResponse =
        FresnelSchlickWithRoughness(lightingData.GetSpecularNdotV(), surface.GetSpecularF0(), surface.roughnessLinear);
    lightingData.diffuseResponse = 1.0 - lightingData.specularResponse;
    lightingData.CalculateMultiscatterCompensation(surface.GetSpecularF0(), o_specularF0_enableMultiScatterCompensation);
    lightingData.emissiveLighting = surface.emissiveLighting;
    lightingData.diffuseAmbientOcclusion = surface.diffuseAmbientOcclusion;
    lightingData.specularOcclusion = surface.specularOcclusion;

    // ---------------- Tile light-culling iterator ----------------
    LightCullingTileIterator tileIterator;
#if ENABLE_LIGHT_CULLING
    tileIterator.Init(IN.m_position, PassSrg::m_lightListRemapped, PassSrg::m_tileLightData);
#else
    tileIterator.InitNoCulling();
#endif

    // ---------------- Direct lighting ----------------
    ApplyDirectLighting(surface, lightingData, IN.m_position, tileIterator);
    lightingData.FinalizeLighting();

    // ---------------- Pack into the 5-target forward output ----------------
    PbrLightingOutput pbr = GetPbrLightingOutput(surface, lightingData, 1.0);

    ForwardPassOutput OUT;
    OUT.m_diffuseColor = pbr.m_diffuseColor;
    OUT.m_diffuseColor.a = -1;   // Disable subsurface scattering.
    OUT.m_specularColor = pbr.m_specularColor;
    OUT.m_specularColor.rgb += lightingData.emissiveLighting;
    OUT.m_albedo = pbr.m_albedo;
    OUT.m_specularF0 = pbr.m_specularF0;
    OUT.m_normal = pbr.m_normal;

    return OUT;
}
